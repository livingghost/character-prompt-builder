{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state-aware-reference-binding.schema.json",
  "title": "State-aware Reference Binding",
  "type": "object",
  "required": [
    "artifact_type",
    "binding_id",
    "role",
    "source",
    "character_id",
    "identity_contract_sha256",
    "effective_story_range",
    "visibly_supported_state",
    "unsupported_or_occluded_state",
    "intended_influence",
    "unsupported_assumptions",
    "review_dimensions",
    "binding_sha256"
  ],
  "properties": {
    "artifact_type": {
      "const": "state-aware-reference-binding"
    },
    "binding_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "role": {
      "$ref": "prepared-generation-reference.schema.json#/$defs/role-slug"
    },
    "source": {
      "oneOf": [
        {
          "$ref": "prepared-generation-reference.schema.json#/$defs/pack-artifact-source"
        },
        {
          "$ref": "prepared-generation-reference.schema.json#/$defs/supplied-file-source"
        }
      ]
    },
    "character_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "identity_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "era_contract_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "appearance_variant_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_snapshot_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "effective_story_range": {
      "type": "object",
      "required": [
        "from_order",
        "to_order"
      ],
      "properties": {
        "from_order": {
          "type": "integer"
        },
        "to_order": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "visibly_supported_state": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unsupported_or_occluded_state": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "intended_influence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "reference-use-plan.schema.json#/$defs/intended-influence"
      },
      "uniqueItems": true
    },
    "unsupported_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "review_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "fallback_if_unstable": {
      "type": "string"
    },
    "superseded_for_future_scenes": {
      "type": "boolean"
    },
    "binding_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
