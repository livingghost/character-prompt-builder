{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production-spec.schema.json",
  "title": "Production Specification",
  "description": "The depiction record for one image artifact. Shared subjects retain identity while an optional layout scopes content, views and visible state to authored regions. A free-text field the author leaves open holds the string \"unspecified\". Referenced identity and state retain their sealed source authority.",
  "type": "object",
  "required": [
    "source_brief",
    "target_model",
    "creative_latitude",
    "image_promise",
    "art_direction",
    "state_context",
    "subjects",
    "scene",
    "lighting",
    "visual_language",
    "constraints",
    "selected_preset_ids",
    "render_intent"
  ],
  "properties": {
    "source_brief": {
      "type": "string"
    },
    "target_model": {
      "type": "string"
    },
    "creative_latitude": {
      "enum": [
        "minimal",
        "directed",
        "expansive"
      ]
    },
    "image_promise": {
      "type": "string"
    },
    "art_direction": {
      "type": "object",
      "required": [
        "center_of_appeal",
        "subject_relationship",
        "composition_and_visual_hierarchy",
        "medium_family",
        "shape_and_rhythm",
        "surface_and_tactility",
        "color_and_light",
        "detail_hierarchy"
      ],
      "properties": {
        "center_of_appeal": {
          "type": "string"
        },
        "subject_relationship": {
          "type": "string"
        },
        "composition_and_visual_hierarchy": {
          "type": "string"
        },
        "medium_family": {
          "type": "string"
        },
        "shape_and_rhythm": {
          "type": "string"
        },
        "surface_and_tactility": {
          "type": "string"
        },
        "color_and_light": {
          "type": "string"
        },
        "detail_hierarchy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "state_context": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "stateless",
            "state-aware"
          ]
        },
        "state_lineage_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scene_context_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "state-aware"
          }
        }
      },
      "then": {
        "required": [
          "state_lineage_sha256",
          "scene_context_ref"
        ]
      },
      "else": {
        "properties": {
          "state_lineage_sha256": {
            "not": {}
          },
          "scene_context_ref": {
            "not": {}
          }
        }
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "identity",
          "current_state",
          "proportions_and_form",
          "surfaces_and_markings",
          "distinctive_details",
          "wardrobe_and_accessories",
          "pose_and_body_geometry",
          "props_and_contacts"
        ],
        "dependentRequired": {
          "identity_contract_ref": [
            "species_morphology_profile_ref",
            "individual_morphology_contract_ref",
            "resolved_morphology"
          ],
          "resolved_morphology": [
            "frame_character",
            "load_bearing_part_measurements"
          ]
        },
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "human",
              "anthropomorphic-animal",
              "animal",
              "creature",
              "hybrid",
              "robot"
            ]
          },
          "identity_contract_ref": {
            "$ref": "#/$defs/artifact_ref"
          },
          "state_snapshot_ref": {
            "$ref": "#/$defs/artifact_ref"
          },
          "visual_projection_ref": {
            "$ref": "#/$defs/artifact_ref"
          },
          "species_morphology_profile_ref": {
            "$ref": "#/$defs/artifact_ref"
          },
          "individual_morphology_contract_ref": {
            "$ref": "#/$defs/artifact_ref"
          },
          "resolved_morphology": {
            "$ref": "resolved-morphology.schema.json"
          },
          "frame_character": {
            "$ref": "frame-character.schema.json"
          },
          "load_bearing_part_measurements": {
            "type": "array",
            "items": {
              "$ref": "part-measurement.schema.json"
            }
          },
          "accessory_geometry": {
            "type": "array",
            "items": {
              "$ref": "accessory-geometry.schema.json"
            }
          },
          "identity": {},
          "current_state": {
            "type": "object"
          },
          "proportions_and_form": {},
          "head_and_face": {},
          "surfaces_and_markings": {},
          "distinctive_details": {
            "type": "array",
            "items": {
              "$ref": "distinctive-detail.schema.json"
            }
          },
          "performance": {
            "$ref": "performance-language.schema.json"
          },
          "wardrobe_and_accessories": {},
          "pose_and_body_geometry": {},
          "hands": {},
          "legs_and_feet": {},
          "gaze_and_head": {},
          "props_and_contacts": {},
          "growth_geometry": {
            "$ref": "growth-geometry.schema.json"
          },
          "garment_geometry": {
            "type": "array",
            "items": {
              "$ref": "garment-geometry.schema.json"
            }
          },
          "structure_notes": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "Optional notes keyed by declared part IDs. No human body-part checklist is required."
          }
        },
        "additionalProperties": false
      }
    },
    "scene": {
      "type": "object"
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "camera": {
      "$ref": "camera-framing-contract.schema.json"
    },
    "lighting": {
      "type": "object"
    },
    "visual_language": {
      "type": "object"
    },
    "constraints": {
      "type": "object"
    },
    "selected_preset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "render_intent": {
      "type": "object",
      "required": [
        "artifact_type",
        "preset",
        "axes",
        "presentation",
        "selection",
        "execution_mode",
        "prompt_expression",
        "regional_overrides"
      ],
      "properties": {
        "artifact_type": {
          "const": "render-intent"
        },
        "preset": {
          "type": [
            "string",
            "null"
          ]
        },
        "axes": {
          "type": "object",
          "required": [
            "medium",
            "dimensionality",
            "linework",
            "shading",
            "surface",
            "detail"
          ],
          "properties": {
            "medium": {
              "type": "string",
              "minLength": 1
            },
            "dimensionality": {
              "type": "string",
              "minLength": 1
            },
            "linework": {
              "type": "string",
              "minLength": 1
            },
            "shading": {
              "type": "string",
              "minLength": 1
            },
            "surface": {
              "type": "string",
              "minLength": 1
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "presentation": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "object",
          "required": [
            "chosen_by",
            "reason"
          ],
          "properties": {
            "chosen_by": {
              "enum": [
                "user",
                "agent"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "execution_mode": {
          "enum": [
            "text-to-image",
            "image-to-image",
            "reference-guided",
            "instruction-edit",
            "upscale"
          ]
        },
        "prompt_expression": {
          "type": "string"
        },
        "regional_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "region",
              "axes",
              "reason",
              "prompt_expression"
            ],
            "properties": {
              "region": {
                "type": "string",
                "minLength": 1
              },
              "axes": {
                "type": "object",
                "required": [],
                "properties": {
                  "medium": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dimensionality": {
                    "type": "string",
                    "minLength": 1
                  },
                  "linework": {
                    "type": "string",
                    "minLength": 1
                  },
                  "shading": {
                    "type": "string",
                    "minLength": 1
                  },
                  "surface": {
                    "type": "string",
                    "minLength": 1
                  },
                  "detail": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "prompt_expression": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "if": {
    "required": [
      "state_context"
    ],
    "properties": {
      "state_context": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "state-aware"
          }
        }
      }
    }
  },
  "then": {
    "properties": {
      "subjects": {
        "items": {
          "if": {
            "required": [
              "state_snapshot_ref"
            ]
          },
          "then": {
            "required": [
              "identity_contract_ref",
              "state_snapshot_ref",
              "visual_projection_ref",
              "growth_geometry"
            ]
          }
        },
        "contains": {
          "required": [
            "state_snapshot_ref"
          ]
        }
      }
    }
  },
  "$defs": {
    "layout": {
      "type": "object",
      "description": "An authored arrangement within one artifact. Regions may be scenes, details, text, diagrams or other content. Reading order expresses attention, independently of depicted time.",
      "required": ["arrangement", "regions"],
      "properties": {
        "arrangement": {
          "type": "string",
          "minLength": 1,
          "description": "The whole artifact's spatial hierarchy, relative region sizes and separation or overlap."
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "placement", "depiction"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "placement": {
                "type": "string",
                "minLength": 1
              },
              "depiction": {
                "type": "string",
                "minLength": 1,
                "description": "The positive visible content, view and local hierarchy selected for this region."
              },
              "subjects": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/subject_occurrence"
                }
              },
              "scene": {
                "type": "object"
              },
              "camera": {
                "$ref": "camera-framing-contract.schema.json"
              },
              "lighting": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "reading_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Region IDs in the intended attention sequence. Include only regions whose ordering is selected. This is not a story timeline."
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "relation"],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "type": "string",
                "minLength": 1,
                "description": "The intended connection, including shared time, elapsed time, enlargement, comparison or continuity wherever applicable."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "subject_occurrence": {
      "type": "object",
      "description": "One depiction of a shared subject. Local state stays within its owning authority; local visibility does not redefine identity.",
      "required": ["subject_id", "depiction"],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "depiction": {
          "type": "string",
          "minLength": 1
        },
        "current_state": {
          "type": "object"
        },
        "pose_and_body_geometry": {},
        "gaze_and_head": {},
        "wardrobe_and_accessories": {},
        "props_and_contacts": {},
        "performance": {
          "$ref": "performance-language.schema.json"
        },
        "visible_elements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "occluded_elements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_ref": {
      "type": "object",
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "else": {
    "properties": {
      "subjects": {
        "items": {
          "properties": {
            "state_snapshot_ref": {
              "not": {}
            },
            "visual_projection_ref": {
              "not": {}
            }
          }
        }
      }
    }
  }
}
