{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "integration-interface.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "artifact_types",
    "required_features",
    "supported_features",
    "unknown_optional_feature_policy",
    "unknown_required_feature_policy",
    "profile_sha256"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "artifact_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supported_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknown_optional_feature_policy": {
      "enum": [
        "preserve",
        "ignore"
      ]
    },
    "unknown_required_feature_policy": {
      "const": "reject"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
