{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-execution-profile.schema.json",
  "title": "Mode-specific interface controls and prompt recipe",
  "type": "object",
  "required": [
    "id",
    "basis",
    "prompt_recipe",
    "modes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "basis": {
      "type": "object",
      "required": [
        "kind",
        "source",
        "limitations"
      ],
      "properties": {
        "kind": {
          "enum": [
            "provider-documentation",
            "curated-starting-point",
            "measured",
            "synthetic"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observed_profile": {
          "description": "The adopted observed request profile a measured basis rests on: a /-separated path inside the pack that holds the model record, and its SHA-256.",
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "kind": {
            "const": "measured"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "observed_profile"
        ]
      },
      "else": {
        "not": {
          "required": [
            "observed_profile"
          ]
        }
      }
    },
    "prompt_recipe": {
      "type": "object",
      "required": [
        "order",
        "guidance"
      ],
      "properties": {
        "order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "guidance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "modes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "media",
          "controls",
          "parameter_schema"
        ],
        "properties": {
          "media": {
            "enum": [
              "none",
              "seed-image",
              "references",
              "input-image"
            ]
          },
          "controls": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "status",
                "binding",
                "schema",
                "recommendation",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "required",
                    "optional",
                    "not-applicable",
                    "backend-managed"
                  ]
                },
                "binding": {
                  "enum": [
                    "package",
                    "dispatch-seed",
                    "dispatch-count"
                  ]
                },
                "schema": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "recommendation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "parameter_schema": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
