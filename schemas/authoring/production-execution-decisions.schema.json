{
  "title": "Execution decisions",
  "description": "Authored operation judgments bound to one prepared input; exact authorization payloads and actor identities are derived by execution.",
  "type": "object",
  "properties": {
    "run": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "enum": [
              "direction",
              "submit"
            ]
          },
          "grant": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          },
          "stop_assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "clear": {
                  "type": "boolean"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "clear",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "request_decision": {
            "type": "object",
            "properties": {
              "case": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "assessments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "criterion": {
                      "type": "string",
                      "minLength": 1
                    },
                    "conclusion": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "criterion",
                    "conclusion",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "principal_approval": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "path",
                      "locator"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "rendition_review": {
                "type": "object",
                "properties": {
                  "assessments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "criterion": {
                          "type": "string",
                          "minLength": 1
                        },
                        "conclusion": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "reason": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "criterion",
                        "conclusion",
                        "reason"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "assessments"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "rendition_review"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "operation",
          "grant",
          "reason",
          "stop_assessments"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run",
    "input_sha256",
    "request_sha256",
    "decisions"
  ],
  "additionalProperties": false
}
