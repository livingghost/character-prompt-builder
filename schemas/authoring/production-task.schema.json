{
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "work_basis": {
      "type": "string",
      "minLength": 1,
      "description": "Acquired authoring basis for the current request, source applications and character definitions. Completed authoring and preparation resolve the actual task content against this basis."
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "applied",
              "considered-not-used"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "$ref": "#/$defs/identitySource"
          },
          "definition_owner": {
            "type": "object",
            "description": "Editable document that owns this derived task-local character definition. Independent acquired definitions retain their own source ownership.",
            "properties": {
              "document": {
                "const": "production_spec"
              },
              "subject_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "document",
              "subject_id"
            ],
            "additionalProperties": false
          },
          "applications": {
            "type": "array",
            "description": "Current source applications derived from the authoring work. Each entry retains its exact selection, subject assignments and requirement role when the task is reopened.",
            "minItems": 0,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^(?:/(?:[^~]|~[01])*)?$"
                },
                "subjects": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "requirement": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "pointer",
                "subjects",
                "requirement"
              ],
              "additionalProperties": false
            }
          },
          "origin": {
            "type": "object",
            "description": "Complete acquired original of a selected source projection. Applications are derived in application-ID order and select values from these bytes; source.path contains the single selected value or the array of values in that canonical order.",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "path",
          "role",
          "disposition",
          "locator",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "delivery": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "translation_notes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "path",
        "translation_notes"
      ],
      "additionalProperties": false
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "strength": {
            "enum": [
              "hard",
              "advisory"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "enum": [
              "artifact",
              "text",
              "image",
              "motion",
              "audio"
            ]
          },
          "identity_bindings": {
            "description": "Explicit scene obligations and their source-to-input bindings. Source values without a binding remain retained identity context for whole-subject review; they do not require a visibility declaration.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/identityBinding"
            }
          },
          "identity_review": {
            "description": "Subjects compared with their complete applicable retained identity sources. The image establishes only what its view and evidence support; this does not require a whole-figure composition.",
            "$ref": "#/$defs/identitySubjects"
          }
        },
        "required": [
          "id",
          "strength",
          "text",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "world_views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string",
            "minLength": 1
          },
          "bundle": {
            "type": "string",
            "minLength": 1
          },
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "view_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "plan",
          "bundle",
          "unit_id",
          "view_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "moment_views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "bundle": {
            "type": "string",
            "minLength": 1
          },
          "view_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "query",
          "bundle",
          "view_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "direction": {
      "$ref": "authoring/production-direction.schema.json"
    },
    "authority": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact": {
      "enum": [
        "text",
        "json",
        "image",
        "video",
        "audio",
        "binary"
      ]
    },
    "execution": {
      "enum": [
        "authored",
        "external",
        "dispatcher"
      ]
    },
    "authored": {
      "$ref": "authoring/production-authored-contract.schema.json"
    },
    "authored_basis": {
      "$ref": "authoring/production-authored-basis.schema.json"
    },
    "scene_materials": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "plan": {
                "type": "string",
                "minLength": 1
              },
              "bundle": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "plan",
              "bundle"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1
              },
              "accepted_content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "accepted_by": {
                "type": "string",
                "minLength": 1
              },
              "acceptance_basis": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "artifact",
              "accepted_content_sha256",
              "accepted_by",
              "acceptance_basis"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "route_reading": {
      "type": "string",
      "minLength": 1
    },
    "production_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "generation": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "render_intent": {
          "$ref": "render-intent.schema.json"
        },
        "parameters": {
          "type": "string",
          "minLength": 1
        },
        "production_spec": {
          "type": "string",
          "minLength": 1
        },
        "plot": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_record": {
          "type": "string",
          "minLength": 1
        },
        "creative_intent": {
          "type": "string",
          "minLength": 1
        },
        "negative": {
          "type": "string",
          "minLength": 1
        },
        "integrated_prompt": {
          "type": "string",
          "minLength": 1
        },
        "native_negative": {
          "type": "string",
          "minLength": 1
        },
        "negative_provenance": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "string",
          "minLength": 1
        },
        "state_lineage": {
          "type": "string",
          "minLength": 1
        },
        "state_snapshot": {
          "type": "string",
          "minLength": 1
        },
        "visual_continuity": {
          "type": "string",
          "minLength": 1
        },
        "request_validation": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "continuity": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative_transport": {
          "enum": [
            "auto",
            "separate-field",
            "integrated-critical",
            "native-subset",
            "retained-only"
          ]
        },
        "critical_avoidance_integrated": {
          "type": "boolean"
        },
        "brief": {
          "type": "string"
        },
        "mask_binding": {
          "type": "string",
          "minLength": 1
        },
        "state_graphs": {
          "type": "string",
          "minLength": 1,
          "description": "Studio-relative JSON array of independently owned existing state artifact graphs for the subjects in this image. Optional for stateless scenes."
        }
      },
      "additionalProperties": false
    },
    "recording": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "character": {
          "type": "string",
          "minLength": 1
        },
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "subject_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "sheet_panel": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "character",
        "slot",
        "subject_map",
        "sheet_panel",
        "role"
      ],
      "additionalProperties": false
    },
    "upscale": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "derivation": {
          "type": "object",
          "properties": {
            "sheet": {
              "type": "string",
              "minLength": 1
            },
            "slot": {
              "type": "string",
              "minLength": 1
            },
            "artifact_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "sheet",
            "slot",
            "artifact_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "service"
      ],
      "additionalProperties": false
    },
    "semantic_edit": {
      "type": "string",
      "minLength": 1,
      "description": "Studio-relative semantic-edit-plan containing existing source, change, preserve and review criteria; requires image_input."
    },
    "image_input": {
      "type": "string",
      "minLength": 1,
      "description": "Studio-relative image-input-plan. Shared exact model, scoped references and optional external request for reference generation and editing."
    },
    "upload_sources": {
      "description": "Service-readable URLs selected by the Studio-relative file holding their exact prepared carrier bytes. Preparation measures each file and binds URLs by content, independently of attachment order. The selected transport declares whether URL sources are required.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "url"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "identitySubjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "identitySelectors": {
      "description": "JSON Pointers relative to the original source or derived source node. An empty string selects the whole value. Subtrees retain all terminal values, including empty collections; selecting source context does not make every value a depiction instruction.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:/(?:[^~]|~[01])*)?$"
      }
    },
    "identitySource": {
      "type": "object",
      "properties": {
        "subject_ids": {
          "$ref": "#/$defs/identitySubjects"
        },
        "selectors": {
          "$ref": "#/$defs/identitySelectors"
        },
        "authority": {
          "$ref": "#/$defs/identitySourceAuthority"
        }
      },
      "required": [
        "subject_ids",
        "selectors"
      ],
      "additionalProperties": false
    },
    "identityAuthorityTerms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "identitySourceAuthority": {
      "description": "The original reference or graph owner's retained review scope, copied unchanged when reopening its source. This does not select a reference for current model input, widen its authority, or assert visual correctness.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "use_for": {
              "$ref": "#/$defs/identityAuthorityTerms",
              "minItems": 1
            },
            "controls": {
              "$ref": "#/$defs/identityAuthorityTerms",
              "minItems": 1
            },
            "intended_influence": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "reference-use-plan.schema.json#/$defs/intended-influence"
              }
            },
            "do_not_transfer": {
              "$ref": "#/$defs/identityAuthorityTerms"
            },
            "subject_uses": {
              "$ref": "prepared-generation-reference.schema.json#/$defs/subject-uses"
            },
            "source": {
              "oneOf": [
                {
                  "$ref": "prepared-generation-reference.schema.json#/$defs/pack-artifact-source"
                },
                {
                  "$ref": "prepared-generation-reference.schema.json#/$defs/supplied-file-source"
                },
                {
                  "$ref": "prepared-generation-reference.schema.json#/$defs/studio-artifact-source"
                },
                {
                  "$ref": "prepared-generation-reference.schema.json#/$defs/studio-accepted-image-source"
                }
              ]
            }
          },
          "required": [
            "reference",
            "use_for",
            "controls",
            "intended_influence",
            "do_not_transfer",
            "subject_uses"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1
            },
            "character_id": {
              "type": "string",
              "minLength": 1
            },
            "canon_status": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "required": [
            "owner",
            "character_id",
            "canon_status"
          ],
          "additionalProperties": false
        }
      ]
    },
    "identityCarrier": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "surface": {
              "enum": [
                "primary",
                "negative"
              ]
            },
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "selection": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "whole": {
                      "const": true
                    }
                  },
                  "required": [
                    "whole"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "occurrence": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "kind",
            "surface"
          ],
          "oneOf": [
            {
              "required": [
                "quote"
              ]
            },
            {
              "required": [
                "selection"
              ]
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "reference"
            },
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "use": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "reference",
            "use"
          ],
          "additionalProperties": false
        }
      ]
    },
    "identityBinding": {
      "description": "An independently authored criterion relates an explicit scene obligation to selected original identity material, its scene treatment and actual input carriers. Other source values remain whole-subject comparison context. This binding does not certify semantic preservation.",
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "subject_ids": {
          "$ref": "#/$defs/identitySubjects"
        },
        "selectors": {
          "$ref": "#/$defs/identitySelectors"
        },
        "treatment": {
          "enum": [
            "preserve",
            "indirect",
            "not-exposed",
            "not-applicable",
            "authorized-variation",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "carriers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identityCarrier"
          }
        },
        "variation": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "source",
        "subject_ids",
        "selectors",
        "treatment",
        "reason",
        "carriers",
        "variation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "treatment": {
                "const": "authorized-variation"
              }
            },
            "required": [
              "treatment"
            ]
          },
          "then": {
            "properties": {
              "variation": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "variation": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "task_id",
    "route",
    "features",
    "sources",
    "delivery",
    "criteria",
    "world_views",
    "direction",
    "authority",
    "artifact",
    "execution",
    "route_reading",
    "production_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "upload_sources"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "const": "dispatcher"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "const": "dispatcher"
          }
        },
        "required": [
          "execution"
        ]
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "generation"
            ],
            "properties": {
              "route": {
                "not": {
                  "const": "upscale"
                }
              }
            },
            "not": {
              "required": [
                "upscale"
              ]
            }
          },
          {
            "required": [
              "upscale"
            ],
            "properties": {
              "route": {
                "const": "upscale"
              },
              "artifact": {
                "const": "image"
              },
              "delivery": {
                "properties": {
                  "transport": {
                    "const": "authored-rendition"
                  }
                }
              }
            },
            "not": {
              "required": [
                "generation"
              ]
            }
          }
        ],
        "properties": {
          "generation": {
            "required": [
              "service",
              "count",
              "seed",
              "continuity"
            ],
            "anyOf": [
              {
                "required": [
                  "production_spec"
                ]
              },
              {
                "required": [
                  "model",
                  "render_intent"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "semantic_edit"
        ]
      },
      "then": {
        "required": [
          "image_input"
        ]
      }
    },
    {
      "if": {
        "required": [
          "image_input"
        ]
      },
      "then": {
        "properties": {
          "artifact": {
            "const": "image"
          },
          "execution": {
            "enum": [
              "external",
              "dispatcher"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution": {
            "const": "external"
          }
        }
      },
      "then": {
        "properties": {
          "generation": {
            "properties": {
              "production_spec": {},
              "state_graphs": {}
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact": {
            "const": "image"
          },
          "execution": {
            "const": "external"
          }
        },
        "required": [
          "artifact",
          "execution"
        ]
      },
      "then": {
        "required": [
          "image_input"
        ]
      }
    }
  ]
}
