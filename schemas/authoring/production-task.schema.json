        "oneOf": [
          {
            "required": [
              "generation"
            ],
            "properties": {
              "route": {
                "not": {
                  "const": "upscale"
                }
              }
            },
            "not": {
              "required": [
                "upscale"
              ]
            }
          },
          {
            "required": [
              "upscale"
            ],
            "properties": {
              "route": {
                "const": "upscale"
              },
              "artifact": {
                "const": "image"
              },
              "delivery": {
                "properties": {
                  "transport": {
                    "const": "authored-rendition"
