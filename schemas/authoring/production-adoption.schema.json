{
  "title": "Authored canonical adoption decision",
  "description": "Author new canonical use or reassess a retained claim under current authority.",
  "oneOf": [
    {
      "title": "Authored canonical adoption decision",
      "description": "One chosen source and canonical destination with actual author judgments; approval, authorization, hashes and claim are derived.",
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "selection": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "character": {
          "type": "string",
          "minLength": 1
        },
        "iteration": {
          "type": "string",
          "minLength": 1
        },
        "slot": {
          "type": "string",
          "minLength": 1
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_state": {
          "type": "object",
          "properties": {
            "placement": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "slot_acceptance": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "iteration_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "image_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "acceptance_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "iteration_id",
                    "image_sha256",
                    "acceptance_sha256"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "adoption": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              ]
            }
          },
          "required": [
            "placement",
            "slot_acceptance",
            "adoption"
          ],
          "additionalProperties": false
        },
        "scope": {
          "enum": [
            "sheet",
            "catalog"
          ]
        },
        "influence": {
          "enum": [
            "identity",
            "pose-camera",
            "outfit",
            "surface-finish",
            "lighting",
            "environment",
            "prop-accessory",
            "local-color"
          ]
        },
        "grant": {
          "type": "string",
          "minLength": 1
        },
        "authority_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "license": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "continuity_decision": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "character_id": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ]
                },
                "continuity": {
                  "enum": [
                    "recurring",
                    "one-off",
                    null
                  ]
                },
                "basis": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "locator": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "locator"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "character_id",
                "continuity",
                "basis"
              ],
              "additionalProperties": false
            }
          ]
        },
        "registration": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "record_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "pack_dir": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "sha256",
                "record_sha256",
                "pack_dir"
              ],
              "additionalProperties": false
            }
          ]
        },
        "stop_assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "clear": {
                "type": "boolean"
              },
              "evidence": {
                "type": "string"
              },
              "condition": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "clear",
              "evidence",
              "condition"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "run",
        "input_sha256",
        "candidate",
        "review",
        "selection",
        "character",
        "iteration",
        "slot",
        "image_sha256",
        "source_state",
        "scope",
        "influence",
        "grant",
        "authority_sha256",
        "at",
        "reason",
        "license",
        "continuity_decision",
        "registration",
        "stop_assessments"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "catalog"
              }
            }
          },
          "then": {
            "properties": {
              "registration": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "record_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "pack_dir": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "record_sha256",
                  "pack_dir"
                ],
                "additionalProperties": false
              }
            }
          },
          "else": {
            "properties": {
              "registration": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    {
      "title": "Current authority for an existing adoption claim",
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope": {
          "enum": [
            "sheet",
            "catalog"
          ]
        },
        "grant": {
          "type": "string",
          "minLength": 1
        },
        "authority_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string"
        },
        "stop_assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "clear": {
                "type": "boolean"
              },
              "evidence": {
                "type": "string"
              },
              "condition": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "clear",
              "evidence",
              "condition"
            ],
            "additionalProperties": false
          }
        },
        "claim": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approval": {
          "type": "object",
          "description": "Exact retained approval supplied by the draft owner; not editable."
        }
      },
      "required": [
        "run",
        "input_sha256",
        "candidate",
        "scope",
        "grant",
        "authority_sha256",
        "reason",
        "stop_assessments",
        "claim",
        "approval"
      ],
      "additionalProperties": false
    }
  ]
}
