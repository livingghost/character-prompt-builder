{
  "title": "Production execution plan",
  "description": "What a prepared run will do when it executes: its operations, quantities, costs, readiness and the fields a variant may change.",
  "type": "object",
  "properties": {
    "run": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "execution": {
      "enum": [
        "authored",
        "external",
        "dispatcher"
      ]
    },
    "input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "request_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "recording": {
      "type": "object"
    },
    "quantities": {
      "type": "object",
      "properties": {
        "uses": {
          "type": "integer",
          "minimum": 1
        },
        "outputs": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "uses",
        "outputs"
      ],
      "additionalProperties": false
    },
    "cost": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/cost"
        }
      ]
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "transport": {
      "type": "string",
      "minLength": 1
    },
    "handoff": {
      "type": "object",
      "properties": {
        "recipient": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "dispatcher"
          ]
        },
        "consumer_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "recipient",
        "method",
        "consumer_sha256",
        "targets"
      ],
      "additionalProperties": false
    },
    "external_effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "request": {
      "type": "object"
    },
    "validation": {
      "type": "object"
    },
    "mutable_fields": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    },
    "readiness": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "authorization_required",
            "configuration_required"
          ]
        },
        "executable": {
          "const": false
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "state",
        "executable",
        "diagnostics"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "run",
    "execution",
    "input_sha256",
    "request_sha256",
    "operations",
    "external_effects",
    "readiness"
  ],
  "dependentRequired": {
    "request": [
      "recording",
      "quantities",
      "cost",
      "service",
      "model",
      "transport",
      "handoff",
      "validation",
      "mutable_fields"
    ]
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operation": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "operation",
        "targets",
        "payload"
      ],
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "currency",
        "amount",
        "basis"
      ],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "upload",
            "send"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "outputs": {
          "type": "integer",
          "minimum": 1
        },
        "cost": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/cost"
            }
          ]
        }
      },
      "required": [
        "operation",
        "count",
        "cost"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "object"
        },
        "required": {
          "type": "boolean"
        },
        "nullable": {
          "type": "boolean"
        },
        "value_form": {
          "enum": [
            "inline",
            "studio-file"
          ]
        },
        "document_type": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rebuild": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "package",
              "request"
            ]
          }
        },
        "protected_criteria": {
          "enum": [
            "unchanged",
            "recheck",
            "redefine"
          ]
        }
      },
      "required": [
        "description",
        "schema",
        "required",
        "nullable",
        "value_form",
        "document_type",
        "checks",
        "rebuild",
        "protected_criteria"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "value_form": {
            "const": "studio-file"
          }
        }
      },
      "then": {
        "properties": {
          "document_type": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "document_type": {
            "type": "null"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "required_action": {
          "type": "string"
        },
        "blocked_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "severity",
        "phase",
        "message",
        "required_action",
        "blocked_checks"
      ]
    }
  }
}
