{
  "title": "Production compilation report",
  "description": "What check returns: every diagnostic, the state of each compiler check, and the preview and execution plan when the input is publishable.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "publishable": {
      "type": "boolean"
    },
    "run": {
      "type": "null"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "passed",
              "failed",
              "not-performed",
              "not-applicable"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "phase",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "external_effect": {
      "const": false
    },
    "formal_run_created": {
      "const": false
    },
    "readiness": {
      "type": "object"
    },
    "request_preview": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        },
        {
          "type": "array"
        }
      ]
    },
    "execution_plan": {
      "$ref": "authoring/production-execution-plan.schema.json"
    },
    "identity_coverage": {
      "type": "object",
      "description": "Derived correspondence from original identity sources to scene treatments, actual request carriers and independent criteria. Structural checks do not establish semantic completeness or visual fidelity."
    },
    "staging": {
      "type": "string",
      "minLength": 1
    },
    "authoring": {
      "description": "The editable choices file this report compiled. A refused compilation holds the authoring result, whose unresolved entries locate each choice still to answer.",
      "type": "object",
      "properties": {
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unresolved_entry"
          }
        }
      }
    }
  },
  "required": [
    "ok",
    "publishable",
    "run",
    "diagnostics",
    "checks",
    "external_effect",
    "formal_run_created"
  ],
  "dependentRequired": {
    "execution_plan": [
      "readiness",
      "request_preview"
    ]
  },
  "additionalProperties": false,
  "if": {
    "properties": {
      "publishable": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "execution_plan",
      "readiness",
      "request_preview"
    ]
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "pointer": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "required_action": {
          "type": "string",
          "minLength": 1
        },
        "blocked_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "guidance": {
          "$ref": "#/$defs/guidance"
        }
      },
      "required": [
        "code",
        "severity",
        "phase",
        "file",
        "pointer",
        "message",
        "required_action",
        "blocked_checks"
      ],
      "if": {
        "properties": {
          "code": {
            "const": "AUTHORED_CHOICE_REQUIRED"
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "$ref": "#/$defs/choice_reason"
          }
        },
        "required": [
          "reason",
          "guidance"
        ]
      }
    },
    "choice_reason": {
      "description": "The kind of unanswered choice that AUTHORED_CHOICE_REQUIRED reports. The code table of references/runtime/production-diagnostics.md explains each one.",
      "enum": [
        "reading-required",
        "target-selection-required",
        "target-evidence-required",
        "selection-required",
        "source-selection-required",
        "selection-evidence-required",
        "continuity-choice-required",
        "authored-choice-required",
        "plot-approval-required",
        "current-judgment-required",
        "provider-upload-required"
      ]
    },
    "unresolved_entry": {
      "description": "One entry of an authoring report's unresolved list. field locates it in the choices file. An AUTHORED_CHOICE_REQUIRED entry also states its reason, what is unanswered, the value to give and where it comes from, and the section that explains it.",
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "required_action": {
          "type": "string",
          "minLength": 1
        },
        "guidance": {
          "$ref": "#/$defs/guidance"
        }
      },
      "required": [
        "field",
        "code"
      ],
      "if": {
        "properties": {
          "code": {
            "const": "AUTHORED_CHOICE_REQUIRED"
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "$ref": "#/$defs/choice_reason"
          },
          "message": {
            "minLength": 1
          }
        },
        "required": [
          "reason",
          "message",
          "required_action",
          "guidance"
        ]
      }
    },
    "guidance": {
      "type": "object",
      "properties": {
        "document_path": {
          "description": "The owning Skill document, optionally followed by its section anchor.",
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "validation": {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "argv",
            "command",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "document_path"
      ],
      "additionalProperties": false
    }
  }
}
