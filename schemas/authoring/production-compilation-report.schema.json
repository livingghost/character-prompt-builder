{
  "title": "Production compilation report",
  "description": "What check returns: every diagnostic, the state of each compiler check, and the preview and execution plan when the input is publishable.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "publishable": {
      "type": "boolean"
    },
    "run": {
      "type": "null"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "passed",
              "failed",
              "not-performed",
              "not-applicable"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "phase",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "external_effect": {
      "const": false
    },
    "formal_run_created": {
      "const": false
    },
    "readiness": {
      "type": "object"
    },
    "request_preview": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        },
        {
          "type": "array"
        }
      ]
    },
    "execution_plan": {
      "$ref": "authoring/production-execution-plan.schema.json"
    },
    "identity_coverage": {
      "type": "object",
      "description": "Derived correspondence from original identity sources to scene treatments, actual request carriers and independent criteria. Structural checks do not establish semantic completeness or visual fidelity."
    },
    "staging": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "ok",
    "publishable",
    "run",
    "diagnostics",
    "checks",
    "external_effect",
    "formal_run_created"
  ],
  "dependentRequired": {
    "execution_plan": [
      "readiness",
      "request_preview"
    ]
  },
  "additionalProperties": false,
  "if": {
    "properties": {
      "publishable": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "execution_plan",
      "readiness",
      "request_preview"
    ]
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "pointer": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "required_action": {
          "type": "string",
          "minLength": 1
        },
        "blocked_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "guidance": {
          "$ref": "#/$defs/guidance"
        }
      },
      "required": [
        "code",
        "severity",
        "phase",
        "file",
        "pointer",
        "message",
        "required_action",
        "blocked_checks"
      ]
    },
    "guidance": {
      "type": "object",
      "properties": {
        "document_path": {
          "description": "The owning Skill document, optionally followed by its section anchor.",
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "validation": {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "argv",
            "command",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "document_path"
      ],
      "additionalProperties": false
    }
  }
}
