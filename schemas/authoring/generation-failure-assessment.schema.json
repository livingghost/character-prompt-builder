{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "generation-failure-assessment.schema.json",
  "title": "Evidence-backed generation failure assessment",
  "type": "object",
  "required": [
    "artifact_type",
    "target",
    "use_cases",
    "category",
    "basis",
    "evidence",
    "signal",
    "reason",
    "unmeasured"
  ],
  "properties": {
    "artifact_type": {
      "const": "generation-failure-assessment"
    },
    "target": {
      "type": "object",
      "required": [
        "service",
        "model_identifier",
        "operation"
      ],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "model_identifier": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "generation",
            "instruction-edit",
            "upscale"
          ]
        }
      },
      "additionalProperties": false
    },
    "use_cases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "category": {
      "enum": [
        "provider-moderation",
        "provider-refusal",
        "authentication",
        "quota",
        "rate-limit",
        "timeout",
        "transport",
        "request-schema",
        "reference-input",
        "output-artifact",
        "unknown"
      ]
    },
    "basis": {
      "enum": [
        "provider-response",
        "runtime-error",
        "visual-review",
        "operator-hypothesis"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "signal": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "pointer",
            "value"
          ],
          "properties": {
            "pointer": {
              "type": "string",
              "pattern": "^(/.*)?$"
            },
            "value": {}
          },
          "additionalProperties": false
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "unmeasured": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "enum": [
              "provider-moderation",
              "provider-refusal"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "basis": {
            "const": "provider-response"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "basis": {
            "const": "provider-response"
          }
        }
      },
      "then": {
        "properties": {
          "signal": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "basis": {
            "const": "operator-hypothesis"
          }
        }
      },
      "then": {
        "properties": {
          "category": {
            "const": "unknown"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "output-artifact"
          }
        }
      },
      "then": {
        "properties": {
          "basis": {
            "const": "visual-review"
          }
        }
      }
    }
  ]
}
