{
  "type": "object",
  "properties": {
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "text",
              "json",
              "image",
              "video",
              "audio",
              "binary"
            ]
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "path",
          "kind",
          "relation",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "whole"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "description"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "lines",
                      "bytes"
                    ]
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "kind",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "image-region"
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "kind",
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "time"
                  },
                  "stream": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "start_seconds": {
                    "type": "string",
                    "minLength": 1
                  },
                  "end_seconds": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "stream",
                  "start_seconds",
                  "end_seconds"
                ],
                "additionalProperties": false
              }
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "evidence",
          "locator",
          "observation",
          "interpretation",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "not-assessed",
              "not-applicable"
            ]
          },
          "observation_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "criterion",
          "verdict",
          "observation_indices",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "observation_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "decisions",
          "observation_indices",
          "operation",
          "targets",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "input_sha256",
    "candidate",
    "reviewer",
    "evidence",
    "observations",
    "checks",
    "repairs",
    "unresolved",
    "conclusion"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "checks": {
            "contains": {
              "type": "object",
              "properties": {
                "verdict": {
                  "const": "fail"
                }
              },
              "required": [
                "verdict"
              ]
            }
          }
        },
        "required": [
          "checks"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "repairs": {
                "minItems": 1
              }
            },
            "required": [
              "repairs"
            ]
          },
          {
            "properties": {
              "unresolved": {
                "minItems": 1
              }
            },
            "required": [
              "unresolved"
            ]
          }
        ]
      }
    }
  ]
}
