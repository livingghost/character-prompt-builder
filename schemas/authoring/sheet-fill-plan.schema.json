{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-prompt-builder-sheet-fill-plan.schema.json",
  "title": "Explicit sheet panel execution plan",
  "type": "object",
  "required": [
    "artifact_type",
    "manifest",
    "sheet",
    "results",
    "panels"
  ],
  "properties": {
    "artifact_type": {
      "const": "sheet-fill-plan"
    },
    "manifest": {
      "type": "string",
      "minLength": 1
    },
    "sheet": {
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "string",
      "minLength": 1,
      "description": "Studio-relative base for automatically allocated UTC-dated attempts; not a flat overwrite destination."
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "request_id",
          "task",
          "references"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "slot",
                "artifact_id",
                "role"
              ],
              "properties": {
                "slot": {
                  "type": "string",
                  "minLength": 1
                },
                "artifact_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{64}$"
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
