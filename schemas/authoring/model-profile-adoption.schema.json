{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPB observed profile adoption decision",
  "type": "object",
  "properties": {
    "artifact_type": {
      "const": "model-profile-adoption"
    },
    "run": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "target": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model_identifier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "service",
        "model_identifier",
        "operation"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "purpose": {
      "enum": [
        "request_acceptance",
        "field_support",
        "visual_effect",
        "reference_influence",
        "output_quality"
      ]
    },
    "conclusion": {
      "const": "supported",
      "description": "Indeterminate or refuted trials remain observations, not adopted observed profiles."
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "provider_statement",
              "request_acceptance",
              "observed_output",
              "measurement",
              "hypothesis"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "result_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "How the measurement was taken."
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "The model, service, mode, settings and reference conditions the measurement covers."
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "description": "What the measurement does not establish."
          }
        },
        "required": [
          "kind",
          "statement",
          "result_sha256"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "observed_output",
                    "measurement"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "result_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "else": {
              "properties": {
                "result_sha256": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "measurement"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "method",
                "scope",
                "limitations"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "method"
                    ]
                  },
                  {
                    "required": [
                      "scope"
                    ]
                  },
                  {
                    "required": [
                      "limitations"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "unmeasured": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "scope",
          "statement"
        ],
        "additionalProperties": false
      }
    },
    "decision": {
      "const": "adopt-profile"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decided_by": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "decided_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "The actual decision time, with its timezone."
    }
  },
  "required": [
    "artifact_type",
    "run",
    "target",
    "question",
    "purpose",
    "conclusion",
    "observations",
    "unmeasured",
    "decision",
    "reason",
    "decided_by",
    "decided_at"
  ],
  "additionalProperties": false
}
