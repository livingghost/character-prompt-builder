{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-timeline-view.schema.json",
  "title": "Read-only story timeline inputs and selected resolver views",
  "type": "object",
  "properties": {
    "artifact_type": {
      "const": "story-timeline-view"
    },
    "base_state": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "string",
      "minLength": 1
    },
    "processes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "view_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "timeline_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "story_order": {
            "type": "integer"
          },
          "story_time": {
            "type": "string",
            "minLength": 1
          },
          "scene_context_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "view_id",
          "label",
          "timeline_id",
          "story_order",
          "story_time",
          "scene_context_id"
        ],
        "additionalProperties": false
      }
    },
    "scene_artwork": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timeline_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "scene_context_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "character": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "slot": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "timeline_id",
          "scene_context_id",
          "character",
          "slot",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "source_id",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "artifact_type",
    "base_state",
    "events",
    "processes",
    "views",
    "scene_artwork",
    "evidence_sources"
  ],
  "additionalProperties": false
}
