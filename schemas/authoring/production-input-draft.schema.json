{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authored production input choices",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reading",
    "visual",
    "validation",
    "task_changes",
    "external"
  ],
  "properties": {
    "reading": {
      "type": [
        "object",
        "null"
      ]
    },
    "visual": {
      "type": [
        "object",
        "null"
      ]
    },
    "validation": {
      "type": [
        "object",
        "null"
      ]
    },
    "task_changes": {
      "type": "object",
      "description": "Explicitly changed authored task fields. The selected task or run owns task identity and authority."
    },
    "external": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image_input"
          ],
          "properties": {
            "image_input": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
