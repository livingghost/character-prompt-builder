{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authored production input choices",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "reading",
    "visual",
    "validation",
    "task_changes",
    "external"
  ],
  "properties": {
    "target": {
      "description": "The single authored target selection. Compilers derive model identities, offering bindings and specification targets from it. Null retains portable authored output.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "model",
            "service"
          ],
          "properties": {
            "kind": {
              "const": "catalog"
            },
            "model": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "service": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "operation": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "execution_mode": {
              "type": "string"
            },
            "parameters": {
              "type": "object"
            },
            "syntax": {
              "type": "string"
            },
            "vocabulary_record": {
              "type": "string",
              "minLength": 1
            },
            "assessment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "use_cases",
                "mode",
                "reference_count"
              ],
              "properties": {
                "use_cases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "mode": {
                  "type": "string"
                },
                "reference_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "operation": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "model_file",
            "service"
          ],
          "properties": {
            "kind": {
              "const": "acquired"
            },
            "model_file": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "service": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "execution_mode": {
              "type": "string"
            },
            "parameters": {
              "type": "object"
            },
            "syntax": {
              "type": "string"
            },
            "vocabulary_record": {
              "type": "string",
              "minLength": 1
            },
            "assessment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "use_cases",
                "mode",
                "reference_count"
              ],
              "properties": {
                "use_cases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "mode": {
                  "type": "string"
                },
                "reference_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "operation": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "model"
          ],
          "properties": {
            "kind": {
              "const": "external"
            },
            "model": {
              "type": [
                "object",
                "null"
              ],
              "description": "Acquired external identity, evidence, prompt input contract and optional dialect; catalog status is derived."
            },
            "reference_model": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "assessment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "use_cases",
                "mode",
                "reference_count"
              ],
              "properties": {
                "use_cases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "mode": {
                  "type": "string"
                },
                "reference_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "operation": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "reading": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "reading_key"
          ],
          "properties": {
            "reading_key": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "visual": {
      "type": [
        "object",
        "null"
      ]
    },
    "validation": {
      "description": "Authored validation mode and source selections. Target identifiers, hashes and validation results are derived during compilation. A null target-schema contract/evidence selects the current offering schema.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "contract",
            "evidence",
            "execution_policy"
          ],
          "properties": {
            "mode": {
              "enum": [
                "target-schema",
                "bounded-probe",
                "observed-profile"
              ]
            },
            "contract": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "evidence": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "execution_policy": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      ]
    },
    "task_changes": {
      "type": "object",
      "description": "Explicitly changed authored task fields. The selected task or run owns task identity and authority.",
      "properties": {
        "upload_sources": {
          "$ref": "authoring/production-task.schema.json#/properties/upload_sources"
        }
      }
    },
    "external": {
      "type": [
        "object",
        "null"
      ],
      "description": "Editable native external request and image input choices, or a selected existing input plan."
    },
    "authoring": {
      "type": "object",
      "description": "One editable source for task decisions, delivery, production documents, references and upscale choices. Paths and hashes are generated by build-inputs.",
      "additionalProperties": false,
      "required": [
        "task",
        "delivery",
        "documents",
        "generation",
        "references",
        "upscale",
        "sources",
        "source_files"
      ],
      "properties": {
        "task": {
          "type": "object"
        },
        "delivery": {
          "type": "object",
          "required": [
            "translation_notes"
          ],
          "additionalProperties": false,
          "properties": {
            "content": {},
            "translation_notes": {
              "type": [
                "string",
                "null"
              ]
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            }
          },
          "oneOf": [
            {
              "required": [
                "content"
              ]
            },
            {
              "required": [
                "file"
              ]
            }
          ],
          "description": "Editable prompt file, or an explicit inline value. File paths are relative to the Studio. The compiler reads the exact current bytes."
        },
        "documents": {
          "type": "object",
          "description": "Select only documents used by the work. A value is its authored content or {file: Studio-relative-path, field: optional JSON path}.",
          "properties": {
            "parameters": {
              "description": "Chosen execution controls, as an object."
            },
            "production_spec": {
              "description": "Selected specialized depiction specification."
            },
            "plot": {
              "description": "Selected approved plot."
            },
            "creative_intent": {
              "description": "Selected creative revision or style decisions."
            },
            "retrieval_record": {
              "description": "Actual search and vocabulary decisions."
            },
            "negative": {
              "description": "Negative text or its editable file."
            },
            "integrated_prompt": {
              "description": "Integrated prompt text or its file."
            },
            "native_negative": {
              "description": "Native negative text or its file."
            },
            "state_graphs": {
              "description": "Selected concrete graph array or lineage and artifact path selection."
            },
            "negative_provenance": {
              "description": "Authored negative provenance selection."
            },
            "state_lineage": {
              "description": "Authored state lineage selection."
            },
            "state_snapshot": {
              "description": "Authored state snapshot selection."
            },
            "visual_continuity": {
              "description": "Authored visual continuity selection."
            },
            "mask_binding": {
              "description": "Authored mask binding selection."
            }
          },
          "additionalProperties": false
        },
        "generation": {
          "type": "object",
          "description": "Rendering intent, quantity, seed and subject continuity. choices.target owns the model and offering.",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ]
            },
            "continuity": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "one-off",
                  "recurring",
                  "undecided"
                ]
              }
            },
            "render_intent": {
              "type": [
                "object",
                "null"
              ],
              "description": "Chosen render intent. prompt_expression may select the complete editable delivery with {document: delivery}."
            },
            "negative_transport": {
              "enum": [
                "auto",
                "separate-field",
                "integrated-critical",
                "native-subset",
                "retained-only"
              ]
            },
            "critical_avoidance_integrated": {
              "type": "boolean"
            },
            "brief": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "references": {
          "type": [
            "object",
            "null"
          ]
        },
        "upscale": {
          "type": [
            "object",
            "null"
          ]
        },
        "source_files": {
          "type": "object",
          "description": "Recorded source-file measurements that bind retained upload URLs and selected identity sources to their original bytes. Drafting derives these witnesses; editing selects sources, files and URLs.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "sources": {
          "type": "object",
          "description": "Editable text or JSON sources keyed by the declared source ID. Source identity and role remain on authoring.task.sources.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "format"
            ],
            "additionalProperties": false,
            "properties": {
              "format": {
                "enum": [
                  "text",
                  "json"
                ]
              },
              "content": {},
              "file": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "content"
                ]
              },
              {
                "required": [
                  "file"
                ]
              }
            ]
          }
        }
      }
    }
  }
}
