{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authored production input choices",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "reading",
    "visual",
    "validation",
    "task_changes",
    "external"
  ],
  "properties": {
    "target": {
      "description": "The single authored target selection. Compilers derive model identities, offering bindings and specification targets from it. Null retains portable authored output.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "model",
            "service"
          ],
          "properties": {
            "kind": {
              "const": "catalog"
            },
            "model": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "service": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "operation": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "execution_mode": {
              "type": "string"
            },
            "parameters": {
              "type": "object"
            },
            "syntax": {
              "type": "string"
            },
            "vocabulary_record": {
              "type": "string",
              "minLength": 1
            },
            "assessment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "use_cases",
                "mode",
                "reference_count"
              ],
              "properties": {
                "use_cases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "mode": {
                  "type": "string"
                },
                "reference_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "operation": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "model_file",
            "service"
          ],
          "properties": {
            "kind": {
              "const": "acquired"
            },
            "model_file": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "service": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "execution_mode": {
              "type": "string"
            },
            "parameters": {
              "type": "object"
            },
            "syntax": {
              "type": "string"
            },
            "vocabulary_record": {
              "type": "string",
              "minLength": 1
            },
            "assessment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "use_cases",
                "mode",
                "reference_count"
              ],
              "properties": {
                "use_cases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "mode": {
                  "type": "string"
                },
                "reference_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "operation": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "model"
          ],
          "properties": {
            "kind": {
              "const": "external"
            },
            "model": {
              "type": [
                "object",
                "null"
              ],
              "description": "Acquired external identity, evidence, prompt input contract and optional dialect; catalog status is derived."
            },
            "reference_model": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "assessment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "use_cases",
                "mode",
                "reference_count"
              ],
              "properties": {
                "use_cases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "mode": {
                  "type": "string"
                },
                "reference_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "operation": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "reading": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "reading_key"
          ],
          "properties": {
            "reading_key": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "visual": {
      "type": [
        "object",
        "null"
      ]
    },
    "validation": {
      "description": "Authored validation mode and source selections. Target identifiers, hashes and validation results are derived during compilation. A null target-schema contract/evidence selects the current offering schema.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "contract",
            "evidence",
            "execution_policy"
          ],
          "properties": {
            "mode": {
              "enum": [
                "target-schema",
                "bounded-probe",
                "observed-profile"
              ]
            },
            "contract": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "evidence": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "execution_policy": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      ]
    },
    "task_changes": {
      "type": "object",
      "description": "Explicitly changed authored task fields. The selected task or run owns task identity and authority.",
      "properties": {
        "upload_sources": {
          "$ref": "authoring/production-task.schema.json#/properties/upload_sources"
        },
        "semantic_edit": {
          "type": "string",
          "minLength": 1,
          "description": "Studio-relative path of the editable semantic edit plan (schemas/authoring/semantic-edit-plan.schema.json). Its source names the scene reference of the image being edited; a draft that starts an edit writes the plan beside its choices with the author's target, change, preserved properties and review criteria unanswered."
        }
      }
    },
    "external": {
      "type": [
        "object",
        "null"
      ],
      "description": "Editable native external request and image input choices, or a selected existing input plan."
    },
    "authoring": {
      "type": "object",
      "description": "Task decisions and selectors of their editable files. Compilers derive output paths, bindings and content hashes from the selected current inputs.",
      "additionalProperties": false,
      "required": [
        "task",
        "delivery",
        "documents",
        "generation",
        "references",
        "upscale",
        "sources",
        "source_files"
      ],
      "properties": {
        "task": {
          "type": "object"
        },
        "delivery": {
          "type": "object",
          "required": [
            "translation_notes"
          ],
          "additionalProperties": false,
          "properties": {
            "content": {},
            "translation_notes": {
              "type": [
                "string",
                "null"
              ]
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            }
          },
          "oneOf": [
            {
              "required": [
                "content"
              ]
            },
            {
              "required": [
                "file"
              ]
            }
          ],
          "description": "Editable prompt file, or an explicit inline value. File paths are relative to the Studio. The compiler reads the exact current bytes."
        },
        "documents": {
          "type": "object",
          "description": "Select only documents used by the work. Each value names the one editable file that owns its content: {file: Studio-relative-path, field: optional JSON path}. Edit that file; compilation captures its current bytes without a manually maintained hash.",
          "properties": {
            "parameters": {
              "description": "Chosen execution controls, as an object.",
              "$ref": "#/$defs/editableDocument"
            },
            "production_spec": {
              "description": "Selected specialized depiction specification.",
              "$ref": "#/$defs/editableDocument"
            },
            "plot": {
              "description": "Selected approved plot.",
              "$ref": "#/$defs/editableDocument"
            },
            "creative_intent": {
              "description": "Selected creative revision or style decisions.",
              "$ref": "#/$defs/editableDocument"
            },
            "retrieval_record": {
              "description": "Actual search and vocabulary decisions.",
              "$ref": "#/$defs/editableDocument"
            },
            "negative": {
              "description": "Negative text or its editable file.",
              "$ref": "#/$defs/editableDocument"
            },
            "integrated_prompt": {
              "description": "Integrated prompt text or its file.",
              "$ref": "#/$defs/editableDocument"
            },
            "native_negative": {
              "description": "Native negative text or its file.",
              "$ref": "#/$defs/editableDocument"
            },
            "state_graphs": {
              "description": "Selected concrete graph array or lineage and artifact path selection.",
              "$ref": "#/$defs/editableDocument"
            },
            "negative_provenance": {
              "description": "Authored negative provenance selection.",
              "$ref": "#/$defs/editableDocument"
            },
            "state_lineage": {
              "description": "Authored state lineage selection.",
              "$ref": "#/$defs/editableDocument"
            },
            "state_snapshot": {
              "description": "Authored state snapshot selection.",
              "$ref": "#/$defs/editableDocument"
            },
            "visual_continuity": {
              "description": "Authored visual continuity selection.",
              "$ref": "#/$defs/editableDocument"
            },
            "mask_binding": {
              "description": "Authored mask binding selection.",
              "$ref": "#/$defs/editableDocument"
            }
          },
          "additionalProperties": false
        },
        "generation": {
          "type": "object",
          "description": "Rendering intent, quantity, seed and subject continuity. choices.target owns the model and offering.",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ]
            },
            "continuity": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "one-off",
                  "recurring",
                  "undecided"
                ]
              }
            },
            "render_intent": {
              "type": [
                "object",
                "null"
              ],
              "description": "Chosen render intent. prompt_expression may select the complete editable delivery with {document: delivery}."
            },
            "negative_transport": {
              "enum": [
                "auto",
                "separate-field",
                "integrated-critical",
                "native-subset",
                "retained-only"
              ]
            },
            "critical_avoidance_integrated": {
              "type": "boolean"
            },
            "brief": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "references": {
          "description": "Ordered reference sources, their uses and the transport for a dispatcher image. The builder prepares the reference set, carriers, attachment order and hashes from these choices. Null selects no references.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transport_mode",
                "max_side",
                "reference_use_plan",
                "reference_selection",
                "additional_references",
                "image_input",
                "zero_reference_reason",
                "source_files"
              ],
              "properties": {
                "transport_mode": {
                  "enum": [
                    "multi-image",
                    "single-board",
                    "prompt-artifacts",
                    "svg-bundle"
                  ]
                },
                "max_side": {
                  "type": "integer",
                  "minimum": 1
                },
                "reference_use_plan": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "Ordered pack reference items with their surface-lighting decisions."
                },
                "reference_selection": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "A state-aware reference selection."
                },
                "additional_references": {
                  "type": "array",
                  "description": "Direct sources in delivery order. A source is a supplied-file selector, a studio-artifact source for current adopted artwork, or a studio-accepted-image source for the slot's current accepted iteration. Preparation verifies the exact adoption or acceptance; an accepted image grants no canonical identity authority.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role",
                      "source"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The use ID that identity bindings and an edit plan name; assigned when the selection is first saved."
                      },
                      "role": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source": {
                        "type": "object"
                      },
                      "subject_uses": {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    }
                  }
                },
                "image_input": {
                  "description": "Null for no image input. {} (or only a derived model) mirrors the prepared sources into the image input: the builder writes one row per prepared source, with its authority as use_for and do_not_transfer. An explicit plan instead lists its own references (id, role, file, use_for, do_not_transfer, subject_uses) and an optional prepared_references set, and then owns the reference order without other selections. choices.target supplies its model.",
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "artifact_type": {
                      "const": "image-input-plan"
                    },
                    "references": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "prepared_references": {
                      "type": "string",
                      "minLength": 1
                    },
                    "external_request": {
                      "type": "null"
                    }
                  }
                },
                "zero_reference_reason": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "source_files": {
                  "type": "object",
                  "description": "Recorded measurements of supplied files by their resolved paths; drafting derives them.",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sha256",
                      "media_type"
                    ],
                    "properties": {
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "media_type": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "upscale": {
          "type": [
            "object",
            "null"
          ]
        },
        "source_files": {
          "type": "object",
          "description": "Recorded source-file measurements that bind retained upload URLs and selected identity sources to their original bytes. Drafting derives these witnesses; editing selects sources, files and URLs.",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "sources": {
          "type": "object",
          "description": "Editable text or JSON sources keyed by the declared source ID. Source identity and role remain on authoring.task.sources.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "format"
            ],
            "additionalProperties": false,
            "properties": {
              "format": {
                "enum": [
                  "text",
                  "json"
                ]
              },
              "content": {},
              "file": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              }
            },
            "oneOf": [
              {
                "required": [
                  "content"
                ]
              },
              {
                "required": [
                  "file"
                ]
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "editableDocument": {
      "type": "object",
      "required": [
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Studio-relative path of the canonical editable document. Compilation measures and captures its current bytes."
        },
        "field": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          },
          "description": "Optional sequence of object keys or array indexes selecting the document inside its JSON file."
        }
      }
    }
  }
}
