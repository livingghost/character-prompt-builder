{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authored production input choices",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reading",
    "visual",
    "validation",
    "task_changes",
    "external"
  ],
  "properties": {
    "reading": {
      "type": [
        "object",
        "null"
      ]
    },
    "visual": {
      "type": [
        "object",
        "null"
      ]
    },
    "validation": {
      "type": [
        "object",
        "null"
      ]
    },
    "task_changes": {
      "type": "object",
      "description": "Explicitly changed authored task fields. The selected task or run owns task identity and authority.",
      "properties": {
        "upload_sources": {
          "$ref": "authoring/production-task.schema.json#/properties/upload_sources"
        }
      }
    },
    "external": {
      "type": [
        "object",
        "null"
      ],
      "description": "Editable native external request and image input choices, or a selected existing input plan."
    },
    "authoring": {
      "type": "object",
      "description": "One editable source for task decisions, delivery, production documents, references and upscale choices. Paths and hashes are generated by build-inputs.",
      "additionalProperties": false,
      "required": [
        "task",
        "delivery",
        "documents",
        "generation",
        "references",
        "upscale",
        "sources",
        "source_files"
      ],
      "properties": {
        "task": {
          "type": "object"
        },
        "delivery": {
          "type": "object",
          "required": [
            "content",
            "translation_notes"
          ],
          "additionalProperties": false,
          "properties": {
            "content": {},
            "translation_notes": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "documents": {
          "type": "object"
        },
        "generation": {
          "type": "object"
        },
        "references": {
          "type": [
            "object",
            "null"
          ]
        },
        "upscale": {
          "type": [
            "object",
            "null"
          ]
        },
        "source_files": {
          "type": "object",
          "description": "Recorded source-file measurements that bind retained upload URLs to their original carrier bytes. Drafting derives these witnesses; editing selects files and URLs.",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "sources": {
          "type": "object",
          "description": "Editable text or JSON sources keyed by the declared source ID. Source identity and role remain on authoring.task.sources.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "format",
              "content"
            ],
            "additionalProperties": false,
            "properties": {
              "format": {
                "enum": [
                  "text",
                  "json"
                ]
              },
              "content": {}
            }
          }
        }
      }
    }
  }
}
