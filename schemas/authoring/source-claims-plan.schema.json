{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-claims-plan.schema.json",
  "type": "object",
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "epistemic_status": {
            "enum": [
              "source-statement",
              "attributed-report",
              "observation",
              "inference",
              "unknown"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "proposed_use": {
            "type": "string",
            "minLength": 1
          },
          "conflicts_with": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "source_id",
                "start_line",
                "end_line"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "claim_id",
          "subject_ids",
          "epistemic_status",
          "text",
          "proposed_use",
          "conflicts_with",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "proposal_id",
    "index_sha256",
    "claims",
    "unresolved"
  ],
  "additionalProperties": false
}
