{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External execution result receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim",
    "actor",
    "outputs",
    "cost",
    "final",
    "response",
    "reason"
  ],
  "properties": {
    "claim": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "integer",
      "minimum": 0
    },
    "cost": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "amount"
          ],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "amount": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            }
          }
        }
      ]
    },
    "final": {
      "type": "boolean"
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "locator"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
