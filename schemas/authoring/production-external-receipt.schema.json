{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External execution result receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim",
    "actor",
    "outputs",
    "cost",
    "final",
    "response",
    "reason"
  ],
  "properties": {
    "claim": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "integer",
      "minimum": 0
    },
    "cost": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "currency",
            "amount"
          ],
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "amount": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            }
          }
        }
      ]
    },
    "final": {
      "type": "boolean"
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "locator"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "submission": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "locator",
            "request_pointer",
            "model_identity_pointer"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "request_pointer": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ]
              }
            },
            "model_identity_pointer": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "integer",
                        "minimum": 0
                      }
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "description": "Saved actual host-call evidence and exact selectors for arguments and optional endpoint/tool identity. A prepared request file alone is not submission evidence."
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
