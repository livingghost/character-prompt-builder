{
  "type": "object",
  "properties": {
    "grant": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "direction",
        "edit",
        "submit",
        "select",
        "adopt"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "payload": {
      "type": "object",
      "minProperties": 1
    },
    "outputs": {
      "type": "integer",
      "minimum": 0
    },
    "cost": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "basis": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "currency",
            "amount",
            "basis"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "stop_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "clear": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "clear",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "request_decision": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "grant",
    "actor",
    "operation",
    "targets",
    "payload",
    "outputs",
    "cost",
    "stop_assessments",
    "reason"
  ],
  "additionalProperties": false
}
