{
  "type": "object",
  "properties": {
    "grant": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "direction",
        "edit",
        "submit",
        "select",
        "adopt"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "payload": {
      "type": "object",
      "minProperties": 1
    },
    "outputs": {
      "type": "integer",
      "minimum": 0
    },
    "stop_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "clear": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "clear",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "request_decision": {
      "description": "An exact model image submission carries the authorized actor's complete rendition review. Dispatcher authority uses principal approval or a delegated case; external image authority uses the exact operation.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "case": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "assessments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "criterion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "request_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "conclusion": {
                    "enum": [
                      "satisfied",
                      "not-satisfied",
                      "unmeasured"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "criterion",
                  "request_sha256",
                  "conclusion",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "principal_approval": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "request_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "principal": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "locator": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "path",
                        "sha256",
                        "locator"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "request_sha256",
                    "principal",
                    "evidence"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "rendition_review": {
              "$ref": "#/$defs/rendition-review"
            }
          },
          "required": [
            "case",
            "assessments",
            "principal_approval",
            "rendition_review"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rendition_review": {
              "$ref": "#/$defs/rendition-review"
            }
          },
          "required": [
            "rendition_review"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "grant",
    "actor",
    "operation",
    "targets",
    "payload",
    "outputs",
    "stop_assessments",
    "reason"
  ],
  "additionalProperties": false,
  "$defs": {
    "rendition-review": {
      "type": "object",
      "properties": {
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "binding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "assessments": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "enum": [
                  "finished-image",
                  "supplied-inputs",
                  "ownership"
                ]
              },
              "conclusion": {
                "enum": [
                  "satisfied",
                  "not-satisfied",
                  "unmeasured"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "criterion",
              "conclusion",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "input_sha256",
        "reviewer",
        "binding_ids",
        "assessments"
      ],
      "additionalProperties": false,
      "description": "Assesses the entire actual input: every text field, native control and delivered image. input_sha256 is the dispatcher request digest or the external image-input binding digest."
    }
  }
}
