{
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "current_task": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/current_task"
        }
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/run"
          },
          {
            "$ref": "#/$defs/blocked_run"
          }
        ]
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "external_effect": {
      "type": "boolean"
    },
    "staging": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "staging_details": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unclaimed_journals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unregistered_publications": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "execution_completed": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "execution_records": {
      "type": "object"
    }
  },
  "required": [
    "ok",
    "current_task",
    "runs",
    "diagnostics",
    "external_effect",
    "staging",
    "staging_details",
    "unclaimed_journals",
    "unregistered_publications",
    "execution_records"
  ],
  "additionalProperties": false,
  "$defs": {
    "preparation": {
      "enum": [
        "staged",
        "prepared"
      ]
    },
    "readiness": {
      "enum": [
        "ready",
        "authorization_required",
        "configuration_required",
        "blocked"
      ]
    },
    "authentication_identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "authentication_variable": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "authentication_selection": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "const": "api_key"
            },
            "service": {
              "$ref": "#/$defs/authentication_identifier"
            }
          },
          "required": [
            "source",
            "service"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "const": "api_key_env"
            },
            "service": {
              "$ref": "#/$defs/authentication_identifier"
            },
            "variable": {
              "$ref": "#/$defs/authentication_variable"
            }
          },
          "required": [
            "source",
            "service",
            "variable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "authentication": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "available": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "selection": {
              "$ref": "#/$defs/authentication_selection"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diagnostic"
              }
            },
            "remote_validation": {
              "const": "not-performed"
            }
          },
          "required": [
            "required",
            "available",
            "selection",
            "diagnostics",
            "remote_validation"
          ],
          "additionalProperties": false
        }
      ]
    },
    "submission": {
      "enum": [
        "unclaimed",
        "claimed",
        "send_started",
        "pending",
        "acknowledged",
        "outcome_unknown",
        "not_executed"
      ]
    },
    "capture": {
      "enum": [
        "none",
        "partial",
        "complete"
      ]
    },
    "registration": {
      "enum": [
        "unregistered",
        "registered",
        "projection-missing"
      ]
    },
    "review": {
      "enum": [
        "unreviewed",
        "partial",
        "complete"
      ]
    },
    "task_disposition": {
      "enum": [
        "open",
        "completed",
        "abandoned"
      ]
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "authentication_input": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Absolute path to the owner's credentials.json on the execution host, using POSIX, Windows drive, or UNC syntax.",
          "type": "string",
          "pattern": "^(?:/|[A-Za-z]:[/\\\\]|\\\\\\\\).+$"
        },
        "format": {
          "const": "json"
        },
        "encoding": {
          "const": "utf-8"
        },
        "json_pointer": {
          "description": "The service's api_key string to edit, or the empty root pointer when the complete JSON needs repair.",
          "type": "string",
          "pattern": "^(?:/[a-z0-9][a-z0-9-]*/api_key)?$"
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "format",
        "encoding",
        "json_pointer",
        "instructions"
      ],
      "additionalProperties": false
    },
    "next_action": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 3
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "draft": {
              "type": "string",
              "minLength": 1
            },
            "requires_author_input": {
              "type": "boolean"
            },
            "input": {
              "$ref": "#/$defs/authentication_input"
            },
            "read_context": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/next_action"
              }
            }
          },
          "required": [
            "command",
            "argv",
            "reason"
          ],
          "additionalProperties": false,
          "if": {
            "required": [
              "input"
            ]
          },
          "then": {
            "properties": {
              "requires_author_input": {
                "const": true
              }
            },
            "required": [
              "requires_author_input"
            ]
          }
        }
      ]
    },
    "current_task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "goal": {
          "type": [
            "string",
            "null"
          ]
        },
        "next": {},
        "production_run": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "task_id",
        "goal",
        "next",
        "production_run"
      ],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "executed",
            "unanswered",
            "rejected",
            "not_executed"
          ]
        }
      },
      "required": [
        "step",
        "operation",
        "result"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "const": "intact"
        },
        "preparation": {
          "$ref": "#/$defs/preparation"
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "readiness_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "authentication": {
          "$ref": "#/$defs/authentication"
        },
        "submission": {
          "$ref": "#/$defs/submission"
        },
        "send_started": {
          "type": "boolean"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "capture_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "registration": {
          "$ref": "#/$defs/registration"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "task_disposition": {
          "$ref": "#/$defs/task_disposition"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "candidate_states": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "freshness_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "selection_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "selection_ready": {
          "type": "boolean"
        },
        "settlement_open": {
          "type": "boolean"
        },
        "journal": {
          "type": [
            "string",
            "null"
          ]
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "$ref": "#/$defs/next_action"
        },
        "execution": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "minLength": 1
                },
                "execution_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "execution_id",
                "status"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "run",
        "task_id",
        "integrity",
        "preparation",
        "readiness",
        "readiness_diagnostics",
        "authentication",
        "submission",
        "send_started",
        "effects",
        "capture",
        "capture_diagnostics",
        "registration",
        "review",
        "task_disposition",
        "candidates",
        "candidate_states",
        "freshness_diagnostics",
        "selection_diagnostics",
        "selection_ready",
        "settlement_open",
        "execution",
        "journal",
        "logs",
        "next_action"
      ],
      "additionalProperties": false
    },
    "blocked_run": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "const": "blocked"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          },
          "minItems": 1
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "$ref": "#/$defs/next_action"
        }
      },
      "required": [
        "run",
        "integrity",
        "diagnostics",
        "logs",
        "next_action"
      ],
      "additionalProperties": false
    }
  }
}
