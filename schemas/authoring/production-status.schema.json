{
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "current_task": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/current_task"
        }
      ]
    },
    "runs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/run"
          },
          {
            "$ref": "#/$defs/blocked_run"
          }
        ]
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "external_effect": {
      "type": "boolean"
    },
    "staging": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "staging_details": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unclaimed_journals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unregistered_publications": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "execution_completed": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "execution_records": {
      "type": "object"
    }
  },
  "required": [
    "ok",
    "current_task",
    "runs",
    "diagnostics",
    "external_effect",
    "staging",
    "staging_details",
    "unclaimed_journals",
    "unregistered_publications",
    "execution_records"
  ],
  "additionalProperties": false,
  "$defs": {
    "preparation": {
      "enum": [
        "staged",
        "prepared",
        "authored"
      ]
    },
    "readiness": {
      "enum": [
        "ready",
        "authorization_required",
        "configuration_required",
        "blocked",
        "not-applicable",
        "unchecked",
        "saved",
        "published"
      ]
    },
    "authentication_identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "authentication_variable": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "authentication_selection": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "const": "api_key"
            },
            "service": {
              "$ref": "#/$defs/authentication_identifier"
            }
          },
          "required": [
            "source",
            "service"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "const": "api_key_env"
            },
            "service": {
              "$ref": "#/$defs/authentication_identifier"
            },
            "variable": {
              "$ref": "#/$defs/authentication_variable"
            }
          },
          "required": [
            "source",
            "service",
            "variable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "authentication": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "available": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "selection": {
              "$ref": "#/$defs/authentication_selection"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/diagnostic"
              }
            },
            "remote_validation": {
              "const": "not-performed"
            }
          },
          "required": [
            "required",
            "available",
            "selection",
            "diagnostics",
            "remote_validation"
          ],
          "additionalProperties": false
        }
      ]
    },
    "submission": {
      "enum": [
        "unclaimed",
        "claimed",
        "send_started",
        "pending",
        "acknowledged",
        "outcome_unknown",
        "not_executed",
        "not-applicable"
      ]
    },
    "capture": {
      "enum": [
        "none",
        "partial",
        "complete",
        "not-applicable"
      ]
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "not-needed",
            "waiting",
            "pending",
            "failed",
            "outcome_unknown",
            "complete",
            "unsupported"
          ]
        },
        "eligible": {
          "type": "boolean"
        },
        "uploaded": {
          "type": "integer",
          "minimum": 0
        },
        "deleted": {
          "type": "integer",
          "minimum": 0
        },
        "retained": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "upload_index": {
                "type": "integer",
                "minimum": 0
              },
              "provider_id": {
                "type": "string",
                "minLength": 1
              },
              "upload_receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "state": {
                "enum": [
                  "pending",
                  "failed",
                  "outcome_unknown",
                  "deleted"
                ]
              }
            },
            "required": [
              "upload_index",
              "provider_id",
              "upload_receipt_sha256",
              "state"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "state",
        "eligible",
        "uploaded",
        "deleted",
        "retained",
        "items"
      ],
      "additionalProperties": false
    },
    "registration": {
      "enum": [
        "unregistered",
        "registered",
        "projection-missing",
        "work-task"
      ]
    },
    "review": {
      "enum": [
        "unreviewed",
        "partial",
        "complete"
      ]
    },
    "task_disposition": {
      "enum": [
        "open",
        "completed",
        "abandoned"
      ]
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "guidance": {
          "$ref": "authoring/production-compilation-report.schema.json#/$defs/guidance"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "authentication_input": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Absolute path to the owner's credentials.json on the execution host, using POSIX, Windows drive, or UNC syntax.",
          "type": "string",
          "pattern": "^(?:/|[A-Za-z]:[/\\\\]|\\\\\\\\).+$"
        },
        "format": {
          "const": "json"
        },
        "encoding": {
          "const": "utf-8"
        },
        "json_pointer": {
          "description": "The service's api_key string to edit, or the empty root pointer when the complete JSON needs repair.",
          "type": "string",
          "pattern": "^(?:/[a-z0-9][a-z0-9-]*/api_key)?$"
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "format",
        "encoding",
        "json_pointer",
        "instructions"
      ],
      "additionalProperties": false
    },
    "next_action": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 3
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "draft": {
              "type": "string",
              "minLength": 1
            },
            "requires_author_input": {
              "type": "boolean"
            },
            "input": {
              "$ref": "#/$defs/authentication_input"
            },
            "read_context": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/next_action"
              }
            },
            "alternatives": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/next_action"
              }
            }
          },
          "required": [
            "command",
            "argv",
            "reason"
          ],
          "additionalProperties": false,
          "if": {
            "required": [
              "input"
            ]
          },
          "then": {
            "properties": {
              "requires_author_input": {
                "const": true
              }
            },
            "required": [
              "requires_author_input"
            ]
          }
        }
      ]
    },
    "current_task": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "goal": {
          "type": [
            "string",
            "null"
          ]
        },
        "next": {},
        "authoring": {
          "$ref": "#/$defs/authoring_state"
        },
        "focus": {
          "enum": [
            "authoring",
            "authored",
            "execution"
          ]
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "production_run": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "work_completion": {
          "type": "object"
        },
        "authoring_action": {
          "description": "In status --run: the status command that inspects every draft of the work task, where this view inspected the drafts of the selected run alone.",
          "type": "object",
          "required": ["command", "argv", "reason"],
          "properties": {
            "command": {"const": "status"},
            "argv": {"type": "array", "items": {"type": "string"}},
            "reason": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "required": [
        "task_id",
        "goal",
        "next",
        "production_run"
      ],
      "additionalProperties": false
    },
    "unresolved": {
      "description": "The choices still to answer and the editable inputs still to repair, as their authoring owners report them.",
      "type": "array",
      "items": {
        "$ref": "authoring/production-compilation-report.schema.json#/$defs/unresolved_entry"
      }
    },
    "authoring_state": {
      "type": "object",
      "properties": {
        "selection_required": {
          "type": "boolean"
        },
        "input_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "unresolved": {
                "$ref": "#/$defs/unresolved"
              }
            }
          }
        },
        "state": {
          "const": "authoring-state"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "unresolved": {
                "$ref": "#/$defs/unresolved"
              },
              "working_copy": {
                "type": "object",
                "properties": {
                  "unresolved": {
                    "$ref": "#/$defs/unresolved"
                  }
                }
              }
            }
          }
        },
        "readings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "last_check": {
          "type": [
            "object",
            "null"
          ]
        },
        "pending": {
          "type": "boolean"
        },
        "context": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "input": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "unresolved": {
                  "$ref": "#/$defs/unresolved"
                }
              }
            }
          }
        },
        "saved": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/saved_authored"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "external_effect": {
          "const": false
        },
        "decision_drafts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "selection_required",
        "input_options",
        "state",
        "task_id",
        "inputs",
        "readings",
        "last_check",
        "pending",
        "context",
        "saved",
        "diagnostics",
        "next_actions",
        "external_effect",
        "decision_drafts"
      ],
      "additionalProperties": false
    },
    "saved_authored": {
      "type": "object",
      "properties": {
        "run": {
          "$ref": "#/$defs/run/properties/run"
        },
        "task_id": {
          "$ref": "#/$defs/run/properties/task_id"
        },
        "task_disposition": {
          "$ref": "#/$defs/run/properties/task_disposition"
        },
        "authored": {
          "$ref": "#/$defs/authored"
        },
        "next_action": {
          "$ref": "#/$defs/run/properties/next_action"
        },
        "working_changes": {
          "type": "boolean"
        }
      },
      "required": [
        "run",
        "task_id",
        "task_disposition",
        "authored",
        "next_action",
        "working_changes"
      ],
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "executed",
            "unanswered",
            "rejected",
            "not_executed"
          ]
        }
      },
      "required": [
        "step",
        "operation",
        "result"
      ],
      "additionalProperties": false
    },
    "authored": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "draft",
            "finished"
          ]
        },
        "completion_state": {
          "enum": [
            "draft",
            "finished"
          ]
        },
        "input_verified": {
          "type": "boolean"
        },
        "saved": {
          "type": [
            "string",
            "null"
          ]
        },
        "delivered": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed": {
          "type": [
            "string",
            "null"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "enum": [
              "save",
              "delivery",
              "review"
            ]
          },
          "uniqueItems": true
        },
        "missing": {
          "type": "array",
          "items": {
            "enum": [
              "finished-revision",
              "save",
              "delivery",
              "review"
            ]
          },
          "uniqueItems": true
        },
        "unresolved": {
          "$ref": "#/$defs/unresolved"
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "state",
        "completion_state",
        "input_verified",
        "saved",
        "delivered",
        "reviewed",
        "requirements",
        "missing",
        "unresolved",
        "artifact"
      ],
      "additionalProperties": false
    },
    "adoption_action": {
      "description": "A saved authoring branch, its exact recorded claim, or a retained claim whose editable draft is unavailable.",
      "type": "object",
      "properties": {
        "command": {"enum": ["adopt", "status"]},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "draft": {"type": ["string", "null"], "minLength": 1},
        "claim": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "completed": {"type": "boolean"},
        "requires_author_input": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "diagnostics": {
          "type": "array",
          "items": {"$ref": "#/$defs/diagnostic"}
        }
      },
      "required": ["command", "argv", "draft", "requires_author_input", "reason", "diagnostics"],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "draft": {"type": "string"},
            "requires_author_input": {"const": true}
          },
          "not": {"anyOf": [{"required": ["claim"]}, {"required": ["completed"]}]}
        },
        {
          "properties": {
            "command": {"const": "adopt"},
            "draft": {"type": "string"},
            "requires_author_input": {"const": false}
          },
          "required": ["claim"],
          "not": {"required": ["completed"]}
        },
        {
          "properties": {
            "command": {"const": "adopt"},
            "draft": {"type": "null"},
            "requires_author_input": {"const": false}
          },
          "required": ["claim", "completed"]
        }
      ]
    },
    "run": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "const": "intact"
        },
        "authored": {
          "$ref": "#/$defs/authored"
        },
        "preparation": {
          "$ref": "#/$defs/preparation"
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        },
        "readiness_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "authentication": {
          "$ref": "#/$defs/authentication"
        },
        "submission": {
          "$ref": "#/$defs/submission"
        },
        "send_started": {
          "type": "boolean"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          }
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "capture_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "cleanup": {
          "$ref": "#/$defs/cleanup"
        },
        "registration": {
          "$ref": "#/$defs/registration"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "task_disposition": {
          "$ref": "#/$defs/task_disposition"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "candidate_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_state"
          }
        },
        "freshness_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "freshness_notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "selection_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "selection_ready": {
          "type": "boolean"
        },
        "settlement_open": {
          "type": "boolean"
        },
        "journal": {
          "type": [
            "string",
            "null"
          ]
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "$ref": "#/$defs/next_action"
        },
        "adoption_actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/adoption_action"}
        },
        "execution": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "minLength": 1
                },
                "execution_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "execution_id",
                "status"
              ],
              "additionalProperties": false
            }
          ]
        },
        "authority": {
          "type": "object"
        },
        "authorization_requirements": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "run",
        "task_id",
        "integrity",
        "preparation",
        "readiness",
        "readiness_diagnostics",
        "authentication",
        "submission",
        "send_started",
        "effects",
        "capture",
        "capture_diagnostics",
        "cleanup",
        "registration",
        "review",
        "task_disposition",
        "candidates",
        "candidate_states",
        "freshness_diagnostics",
        "freshness_notices",
        "selection_diagnostics",
        "selection_ready",
        "settlement_open",
        "execution",
        "journal",
        "logs",
        "next_action"
      ],
      "additionalProperties": false
    },
    "blocked_run": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "integrity": {
          "const": "blocked"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          },
          "minItems": 1
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "$ref": "#/$defs/next_action"
        }
      },
      "required": [
        "run",
        "integrity",
        "diagnostics",
        "logs",
        "next_action"
      ],
      "additionalProperties": false
    },
    "selection_requirements": {
      "type": "object",
      "properties": {
        "unassessed_hard_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "nonpassing_hard_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unresolved_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        }
      },
      "required": [
        "unassessed_hard_criteria",
        "nonpassing_hard_criteria",
        "unresolved_indices"
      ],
      "additionalProperties": false
    },
    "candidate_state": {
      "type": "object",
      "properties": {
        "run": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidate_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evaluation": {
          "enum": [
            "unreviewed",
            "nonconforming",
            "indeterminate",
            "partially_reviewed",
            "conforming"
          ]
        },
        "disposition": {
          "enum": [
            "pending",
            "not_selected",
            "selected"
          ]
        },
        "unassessed_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "review": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_detail": {
          "anyOf": [
            {
              "$ref": "authoring/production-selection.schema.json"
            },
            {
              "$ref": "authoring/production-disposition.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_basis": {
          "enum": [
            null,
            "review-pass",
            "owner-allowance"
          ]
        },
        "owner_acceptance": {
          "anyOf": [
            {
              "$ref": "authoring/production-selection.schema.json#/$defs/owner_acceptance"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_requirements": {
          "$ref": "#/$defs/selection_requirements"
        },
        "selection_current": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "selection_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "run",
        "candidate",
        "candidate_sha256",
        "evaluation",
        "disposition",
        "unassessed_criteria",
        "review",
        "decision",
        "decision_detail",
        "reviewed_at",
        "decided_at",
        "selection_basis",
        "owner_acceptance",
        "selection_requirements",
        "selection_current",
        "selection_diagnostics"
      ],
      "additionalProperties": false
    }
  }
}
