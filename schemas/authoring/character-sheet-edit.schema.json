{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-prompt-builder-character-sheet-edit.schema.json",
  "title": "Authored Character Sheet difference",
  "description": "Apply touched author keys under a sheet lock; runtime artwork and adoption are not editor fields.",
  "type": "object",
  "required": [
    "artifact_type",
    "before",
    "after"
  ],
  "properties": {
    "artifact_type": {
      "const": "character-sheet-edit"
    },
    "before": {
      "$ref": "#/$defs/authoring"
    },
    "after": {
      "$ref": "#/$defs/authoring"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "authoring": {
      "type": "object",
      "required": [
        "fields",
        "tables",
        "fill_policies"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "tables": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "row_id",
                "values"
              ],
              "properties": {
                "row_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*\\.[0-9]{2,}$"
                },
                "values": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "fill_policies": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "additionalProperties": {
            "enum": [
              "auto",
              "fill",
              "keep",
              "skip"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
