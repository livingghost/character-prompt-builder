{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-prompt-builder-character-sheet-render-profile.schema.json",
  "title": "Character Sheet Render Profile",
  "description": "Kind-specific layout declaration for the Character Sheet PNG renderer.",
  "type": "object",
  "required": [
    "id",
    "title",
    "canvas",
    "header_fields",
    "rows"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "canvas": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 800
      }
    },
    "header_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "field_id",
          "label"
        ],
        "properties": {
          "field_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "guide_lines": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scaffold_guide_lines": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reference_guide_lines": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "height",
          "boxes"
        ],
        "properties": {
          "height": {
            "type": "integer",
            "minimum": 120
          },
          "section_label": {
            "type": "string",
            "minLength": 1
          },
          "boxes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "slot_id",
                "label",
                "hint"
              ],
              "properties": {
                "slot_id": {
                  "type": "string",
                  "minLength": 1
                },
                "aliases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "output_name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.png$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "hint": {
                  "type": "string",
                  "minLength": 1
                },
                "caption": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "source_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "source_row_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*\\.[0-9]{2,}$"
                },
                "source_view_row_id": {
                  "type": "string",
                  "pattern": "^views\\.[0-9]{2,}$"
                },
                "harvest": {
                  "type": "boolean"
                },
                "footer_height": {
                  "type": "integer",
                  "minimum": 36
                },
                "panel_code": {
                  "type": "string",
                  "pattern": "^[A-Z][0-9]+$"
                },
                "reference_role": {
                  "enum": [
                    "identity",
                    "performance",
                    "support"
                  ]
                },
                "default_fill_policy": {
                  "enum": [
                    "auto",
                    "fill",
                    "keep",
                    "skip"
                  ]
                },
                "skip_hint": {
                  "type": "string",
                  "minLength": 1
                },
                "source_part": {
                  "type": "string",
                  "minLength": 1
                },
                "counterpart_comparison": {
                  "type": "boolean"
                },
                "long_side": {
                  "type": "integer",
                  "minimum": 1024,
                  "description": "Overrides panel_long_side for this panel."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "panel_long_side": {
      "type": "integer",
      "minimum": 1024,
      "description": "Long side, in pixels, of the image each panel request asks the model for. The board box shows a reduced copy; this is the size of the panel itself."
    }
  },
  "additionalProperties": false
}
