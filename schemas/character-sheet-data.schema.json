{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-prompt-builder-character-sheet-data.schema.json",
  "title": "Character Prompt Builder Character Sheet Sidecar",
  "description": "Authoring fields and immutable artwork selections. Candidates never replace current artwork without an evidenced adoption.",
  "type": "object",
  "required": [
    "sheet_status",
    "fields",
    "tables",
    "slots"
  ],
  "properties": {
    "sheet_status": {
      "enum": [
        "draft",
        "identity-ready",
        "reference-ready"
      ]
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "tables": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "row_id",
            "values"
          ],
          "properties": {
            "row_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*\\.[0-9]{2,}$"
            },
            "values": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "current",
          "candidates",
          "history"
        ],
        "properties": {
          "current": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/acceptance"
              }
            ]
          },
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/artifact"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/acceptance"
            }
          },
          "fill_policy": {
            "enum": [
              "auto",
              "fill",
              "keep",
              "skip"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "image",
        "provenance"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "image": {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "width",
            "height",
            "media_type"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "media_type": {
              "enum": [
                "image/png",
                "image/jpeg",
                "image/webp"
              ]
            }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": [
            "kind",
            "path",
            "sha256"
          ],
          "properties": {
            "kind": {
              "enum": [
                "generation",
                "upscale",
                "crop",
                "resize",
                "composite",
                "shared"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": [
        "artifact",
        "approval"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "approval": {
          "type": "object",
          "required": [
            "decision_sha256",
            "decision_path",
            "evidence_path",
            "evidence_sha256"
          ],
          "properties": {
            "decision_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "decision_path": {
              "type": "string",
              "minLength": 1
            },
            "evidence_path": {
              "type": "string",
              "minLength": 1
            },
            "evidence_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
