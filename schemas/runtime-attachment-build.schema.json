{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["artifact_type", "build_id", "source_ref_id", "source_sha256", "recipes", "notes", "runtime_attachment_build_sha256"],
  "properties": {
    "artifact_type": {"const": "runtime-attachment-build"},
    "build_id": {"type": "string"},
    "source_ref_id": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recipes": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "runtime_attachment_build_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
