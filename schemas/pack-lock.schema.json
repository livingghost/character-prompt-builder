{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-prompt-builder-pack-lock.schema.json",
  "title": "Character Prompt Builder Pack Lock",
  "description": "The generated immutable file inventory for one released content pack.",
  "type": "object",
  "required": [
    "pack_id",
    "release",
    "files",
    "content_sha256"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "release": {
      "$ref": "#/$defs/calver"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256",
          "media_type",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "manifest",
              "record",
              "resource",
              "evidence",
              "documentation",
              "license",
              "other"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "calver": {
      "type": "string",
      "pattern": "^(?:(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})\\.(?:(?:01|03|05|07|08|10|12)\\.(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)\\.(?:0[1-9]|[12][0-9]|30)|02\\.(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)\\.02\\.29)\\.[1-9][0-9]*$"
    }
  },
  "additionalProperties": false
}
