{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state-event.schema.json",
  "title": "Canonical State Event",
  "type": "object",
  "required": [
    "artifact_type",
    "event_id",
    "timeline_id",
    "event_scope",
    "targets",
    "effective_order",
    "effective_from",
    "recorded_at",
    "occurrence",
    "canon_status",
    "cause",
    "preconditions",
    "changes",
    "evidence",
    "atomic"
  ],
  "properties": {
    "artifact_type": {
      "const": "state-event"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timeline_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scene_context_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "event_scope": {
      "enum": [
        "physical-state",
        "appearance-state",
        "wardrobe-state",
        "equipment-state",
        "inventory-transfer",
        "emotional-state",
        "relationship-state",
        "knowledge-state",
        "environment-state",
        "social-role-state",
        "form-transition",
        "background-process",
        "editorial-revision"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "uniqueItems": true
    },
    "effective_order": {
      "type": "integer"
    },
    "effective_from": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1
    },
    "disclosed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurrence": {
      "enum": [
        "onscreen",
        "offscreen",
        "editorial"
      ]
    },
    "canon_status": {
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "superseded"
      ]
    },
    "atomic": {
      "type": "boolean"
    },
    "cause": {
      "type": "object",
      "required": [
        "type",
        "reference"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_type",
          "entity_id",
          "path",
          "operator"
        ],
        "properties": {
          "entity_type": {
            "enum": [
              "character",
              "relationship",
              "environment",
              "prop",
              "world"
            ]
          },
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "operator": {
            "enum": [
              "equals",
              "not-equals",
              "exists",
              "not-exists",
              "contains"
            ]
          },
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "entity_type",
              "entity_id",
              "path",
              "operation",
              "persistence"
            ],
            "properties": {
              "entity_type": {
                "enum": [
                  "character",
                  "relationship",
                  "environment",
                  "prop",
                  "world"
                ]
              },
              "entity_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "operation": {
                "enum": [
                  "set",
                  "replace",
                  "merge",
                  "remove",
                  "append",
                  "increment"
                ]
              },
              "value": {},
              "persistence": {
                "enum": [
                  "scene-local",
                  "temporary-until-cleared",
                  "decaying",
                  "progressive",
                  "persistent-until-superseded",
                  "era-level",
                  "form-level"
                ]
              },
              "visual_priority": {
                "enum": [
                  "signature",
                  "supporting",
                  "optional",
                  "nonvisual"
                ]
              },
              "process_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "clear_event_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "effective_until_order": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "entity_type",
              "entity_id",
              "path",
              "operation",
              "process_id"
            ],
            "properties": {
              "entity_type": {
                "enum": [
                  "character",
                  "relationship",
                  "environment",
                  "prop",
                  "world"
                ]
              },
              "entity_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "operation": {
                "enum": [
                  "interrupt-process",
                  "restart-process"
                ]
              },
              "process_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "supersedes_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
