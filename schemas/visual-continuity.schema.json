{
  "type": "object",
  "properties": {
    "purpose": {
      "enum": [
        "sheet-panel",
        "image"
      ]
    },
    "basis": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "locator"
      ],
      "additionalProperties": false
    },
    "subjects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "continuity": {
            "enum": [
              "recurring",
              "one-off",
              "undecided"
            ]
          },
          "character_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "studio_character": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "identity_refs": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "slot": {
                      "type": "string",
                      "minLength": 1
                    },
                    "iteration_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "reference_number": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "slot",
                    "iteration_id",
                    "source_sha256",
                    "reference_number"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "slot",
                    "artifact_id",
                    "proof_sha256",
                    "source_sha256",
                    "reference_number"
                  ],
                  "properties": {
                    "kind": {
                      "const": "studio-artifact"
                    },
                    "slot": {
                      "type": "string",
                      "minLength": 1
                    },
                    "artifact_id": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "proof_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "source_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "reference_number": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "continuity",
          "character_id",
          "studio_character",
          "identity_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "purpose",
    "basis",
    "subjects"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual continuity input"
}
