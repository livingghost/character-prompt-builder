{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production-spec.schema.json",
  "title": "Scene Production Specification",
  "description": "The scene record for one image. A free-text field the author leaves open holds the string \"unspecified\". A subject that names an identity contract carries its morphology references and resolved morphology; a state-aware specification also names its lineage, scene context, state snapshot and visual projection.",
  "type": "object",
  "required": [
    "source_brief",
    "target_model",
    "creative_latitude",
    "image_promise",
    "art_direction",
    "state_context",
    "subjects",
    "scene",
    "camera",
    "lighting",
    "visual_language",
    "constraints",
    "selected_preset_ids"
  ],
  "properties": {
    "source_brief": {
      "type": "string"
    },
    "target_model": {
      "type": "string"
    },
    "creative_latitude": {
      "enum": [
        "minimal",
        "directed",
        "expansive"
      ]
    },
    "image_promise": {
      "type": "string"
    },
    "art_direction": {
      "type": "object",
      "required": [
        "center_of_appeal",
        "subject_relationship",
        "composition_and_visual_hierarchy",
        "medium_family",
        "shape_and_rhythm",
        "surface_and_tactility",
        "color_and_light",
        "detail_hierarchy"
      ],
      "properties": {
        "center_of_appeal": {
          "type": "string"
        },
        "subject_relationship": {
          "type": "string"
        },
        "composition_and_visual_hierarchy": {
          "type": "string"
        },
        "medium_family": {
          "type": "string"
        },
        "shape_and_rhythm": {
          "type": "string"
        },
        "surface_and_tactility": {
          "type": "string"
        },
        "color_and_light": {
          "type": "string"
        },
        "detail_hierarchy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "state_context": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "stateless",
            "state-aware"
          ]
        },
        "state_lineage_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scene_context_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "if": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "state-aware"
          }
        }
      },
      "then": {
        "required": [
          "state_lineage_sha256",
          "scene_context_ref"
        ]
      },
      "else": {
        "properties": {
          "state_lineage_sha256": {
            "not": {}
          },
          "scene_context_ref": {
            "not": {}
          }
        }
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "identity",
          "current_state",
          "proportions_and_form",
          "surfaces_and_markings",
          "distinctive_details",
          "performance",
          "wardrobe_and_accessories",
          "pose_and_body_geometry",
          "props_and_contacts"
        ],
        "dependentRequired": {
          "identity_contract_ref": [
            "species_morphology_profile_ref",
            "individual_morphology_contract_ref",
            "resolved_morphology"
          ],
          "resolved_morphology": [
            "frame_character",
            "load_bearing_part_measurements"
          ]
        },
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "human",
              "anthropomorphic-animal",
              "animal",
              "creature",
              "hybrid",
              "robot"
            ]
          },
          "identity_contract_ref": {
            "$ref": "#/$defs/artifact_ref"
          },
          "state_snapshot_ref": {
            "$ref": "#/$defs/artifact_ref"
          },
          "visual_projection_ref": {
            "$ref": "#/$defs/artifact_ref"
          },
          "species_morphology_profile_ref": {
            "$ref": "#/$defs/artifact_ref"
          },
          "individual_morphology_contract_ref": {
            "$ref": "#/$defs/artifact_ref"
          },
          "resolved_morphology": {
            "$ref": "resolved-morphology.schema.json"
          },
          "frame_character": {
            "$ref": "frame-character.schema.json"
          },
          "load_bearing_part_measurements": {
            "type": "array",
            "items": {
              "$ref": "part-measurement.schema.json"
            }
          },
          "accessory_geometry": {
            "type": "array",
            "items": {
              "$ref": "accessory-geometry.schema.json"
            }
          },
          "identity": {},
          "current_state": {
            "type": "object"
          },
          "proportions_and_form": {},
          "head_and_face": {},
          "surfaces_and_markings": {},
          "distinctive_details": {
            "type": "array",
            "items": {
              "$ref": "distinctive-detail.schema.json"
            }
          },
          "performance": {
            "$ref": "performance-language.schema.json"
          },
          "wardrobe_and_accessories": {},
          "pose_and_body_geometry": {},
          "hands": {},
          "legs_and_feet": {},
          "gaze_and_head": {},
          "props_and_contacts": {},
          "growth_geometry": {
            "$ref": "growth-geometry.schema.json"
          },
          "garment_geometry": {
            "type": "array",
            "items": {
              "$ref": "garment-geometry.schema.json"
            }
          },
          "structure_notes": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "Optional notes keyed by declared part IDs. No human body-part checklist is required."
          }
        },
        "additionalProperties": false
      }
    },
    "scene": {
      "type": "object"
    },
    "camera": {
      "$ref": "camera-framing-contract.schema.json"
    },
    "lighting": {
      "type": "object"
    },
    "visual_language": {
      "type": "object"
    },
    "constraints": {
      "type": "object"
    },
    "selected_preset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "if": {
    "required": [
      "state_context"
    ],
    "properties": {
      "state_context": {
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "const": "state-aware"
          }
        }
      }
    }
  },
  "then": {
    "properties": {
      "subjects": {
        "items": {
          "required": [
            "identity_contract_ref",
            "state_snapshot_ref",
            "visual_projection_ref",
            "growth_geometry"
          ]
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_ref": {
      "type": "object",
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
