{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene-persona-material.schema.json",
  "type": "object",
  "properties": {
    "material_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_source_id": {
      "type": "string",
      "minLength": 1
    },
    "medium": {
      "enum": [
        "text",
        "image"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "enum": [
              "persona",
              "functional",
              "unresolved"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "portrayal_basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "subject_id",
          "model",
          "source_ids",
          "portrayal_basis"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "definition_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "kind": {
            "enum": [
              "interpretation",
              "option",
              "unresolved"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "application_id",
          "subject_ids",
          "definition_ids",
          "kind",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "interaction_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "definition_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "interaction_id",
          "subject_ids",
          "definition_ids",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "reopen_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "review": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "ready",
            "needs-review"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "from_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "kind": {
                "enum": [
                  "correction",
                  "addition"
                ]
              },
              "anchors": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "decision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_id",
              "from_sha256",
              "kind",
              "anchors",
              "decision"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "by",
        "decision",
        "basis",
        "limitations",
        "revisions"
      ],
      "additionalProperties": false
    },
    "artifact_type": {
      "const": "scene-persona-material"
    },
    "audience": {
      "const": "authoring"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reading_basis": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "anchor": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "body_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "blank": {
                  "type": "boolean"
                }
              },
              "required": [
                "anchor",
                "sha256",
                "body_sha256",
                "blank"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "source_id",
          "path",
          "role",
          "subject_ids",
          "sha256",
          "reading_basis",
          "bytes",
          "units"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "excerpt_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "anchor": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "excerpt_id",
          "source_id",
          "anchor",
          "subject_ids",
          "depends_on",
          "reason",
          "text",
          "text_sha256",
          "source_sha256",
          "covers"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "identities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "studio_character": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "type": "string",
            "minLength": 1
          },
          "iteration_id": {
            "type": "string",
            "minLength": 1
          },
          "image_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "subject_id",
          "studio_character",
          "slot",
          "iteration_id",
          "image_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "source_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "material_id",
    "scene_id",
    "scene_source_id",
    "medium",
    "purpose",
    "conditions",
    "subjects",
    "applications",
    "interactions",
    "constraints",
    "unknowns",
    "reopen_when",
    "review",
    "artifact_type",
    "audience",
    "sources",
    "definitions",
    "identities",
    "source_set_sha256",
    "content_sha256",
    "supersedes"
  ],
  "additionalProperties": false
}
