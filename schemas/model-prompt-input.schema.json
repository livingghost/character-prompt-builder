{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-prompt-builder-model-prompt-input.schema.json",
  "title": "Model Prompt Input",
  "description": "Documented wording and vocabulary guidance for one selected model, adapter, or operation. Tag-based requires vocabulary search even when the model also accepts prose. Honor an exclusive requested form; otherwise use the selected guidance to preserve the depiction. Available forms are not an exhaustive list of permitted wording and do not establish reliable control of every instruction. Missing evidence is represented by unresolved with an empty basis.",
  "type": "object",
  "required": ["mode", "forms", "vocabularies", "basis"],
  "additionalProperties": false,
  "properties": {
    "mode": {
      "enum": ["tag-based", "descriptive", "unresolved", "none"]
    },
    "forms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["tags", "natural-language", "structured-caption"]
      }
    },
    "vocabularies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "basis": {
      "type": "array",
      "items": {"$ref": "#/$defs/basis"}
    },
    "notes": {
      "type": "array",
      "items": {"$ref": "#/$defs/text"}
    }
  },
  "oneOf": [
    {
      "properties": {
        "mode": {"const": "tag-based"},
        "forms": {"contains": {"const": "tags"}},
        "vocabularies": {"minItems": 1},
        "basis": {"minItems": 1}
      }
    },
    {
      "properties": {
        "mode": {"const": "descriptive"},
        "forms": {
          "minItems": 1,
          "items": {"enum": ["natural-language", "structured-caption"]}
        },
        "vocabularies": {"maxItems": 0},
        "basis": {"minItems": 1}
      }
    },
    {
      "properties": {
        "mode": {"const": "unresolved"},
        "forms": {"maxItems": 0},
        "vocabularies": {"maxItems": 0}
      }
    },
    {
      "properties": {
        "mode": {"const": "none"},
        "forms": {"maxItems": 0},
        "vocabularies": {"maxItems": 0},
        "basis": {"minItems": 1}
      }
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "basis": {
      "type": "object",
      "required": ["kind", "source", "scope", "observed_at", "statement"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["provider-documentation", "model-author-documentation", "author-direction", "synthetic-fixture"]
        },
        "source": {"$ref": "#/$defs/text"},
        "scope": {
          "enum": ["model", "family", "adapter", "operation", "author-selection"]
        },
        "observed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "statement": {"$ref": "#/$defs/text"}
      }
    },
    "model-record": {
      "type": "object",
      "required": ["prompt_input"],
      "properties": {
        "prompt_input": {"$ref": "#"},
        "prompt_dialect": {
          "$ref": "#/$defs/identifier",
          "description": "The owning family in the prompt-dialects resource. Required for tag-based input and absent for every other mode."
        }
      },
      "if": {
        "properties": {
          "prompt_input": {
            "properties": {"mode": {"const": "tag-based"}}
          }
        }
      },
      "then": {"required": ["prompt_dialect"]},
      "else": {"not": {"required": ["prompt_dialect"]}}
    }
  }
}
