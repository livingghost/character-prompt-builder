{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operation knowledge delivery record",
  "type": "object",
  "required": [
    "route",
    "operation",
    "execution",
    "features",
    "reading_key",
    "documents",
    "resources",
    "model"
  ],
  "properties": {
    "route": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reading_key": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object"
    },
    "operation": {
      "type": "string",
      "enum": [
        "author",
        "save",
        "prepare",
        "execute",
        "review",
        "adopt"
      ]
    },
    "execution": {
      "type": "string",
      "enum": [
        "authored",
        "external",
        "dispatcher"
      ]
    },
    "model": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "id",
            "record_sha256",
            "service",
            "guidance_sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "record_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "service": {
              "type": [
                "string",
                "null"
              ]
            },
            "guidance_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
