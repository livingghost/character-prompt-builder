{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Route reading record",
  "type": "object",
  "required": [
    "route",
    "features",
    "reading_key",
    "documents",
    "applied",
    "resources",
    "resource_applied"
  ],
  "properties": {
    "route": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reading_key": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "additionalProperties": false
      }
    },
    "applied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "quote",
          "why"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object"
    },
    "resource_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource",
          "pointer",
          "quote",
          "why"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "pointer": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
