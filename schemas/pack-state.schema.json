{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character-prompt-builder-pack-state.schema.json",
  "title": "Character Prompt Builder Pack State",
  "description": "The sole user-controlled state: registered pack roots, enabled pack identities, packs the author chose to leave disabled, and the rank of packs that neither requires.",
  "type": "object",
  "required": [
    "pack_roots",
    "enabled_packs"
  ],
  "properties": {
    "pack_roots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "enabled_packs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
      }
    },
    "disabled_packs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
      }
    },
    "pack_order": {
      "description": "Packs that neither requires the other, highest rank first: where two bind one resource name or define one record ID, the earlier pack supplies it.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-7[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
      }
    }
  },
  "additionalProperties": false
}
