{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interchange-envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "envelope_id",
    "contract_profile",
    "profile_sha256",
    "origin",
    "payload",
    "required_features",
    "optional_features",
    "extensions",
    "envelope_sha256"
  ],
  "properties": {
    "artifact_type": {
      "const": "interchange-envelope"
    },
    "envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_profile": {
      "type": "string",
      "minLength": 1
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_manifest_sha256"
      ],
      "properties": {
        "capability_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_id",
        "media_type",
        "sha256"
      ],
      "properties": {
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "const": "application/json"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "required_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "optional_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "object"
    },
    "envelope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
