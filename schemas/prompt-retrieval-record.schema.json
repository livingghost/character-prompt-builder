{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt-retrieval-record.schema.json",
  "title": "Prompt Retrieval Record",
  "description": "Construction investigations and model-bound vocabulary choices. Descriptive work may have no construction inquiries. Tag-based input requires searched and resolved vocabulary for the actual model, text, syntax and dictionary.",
  "type": "object",
  "required": [
    "artifact_type",
    "elements"
  ],
  "properties": {
    "artifact_type": {
      "const": "prompt-retrieval-record"
    },
    "pack_state": {
      "type": "string",
      "minLength": 1,
      "description": "Identifier of the resolved pack runtime the lookups ran against."
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "element",
          "outcome"
        ],
        "properties": {
          "element": {
            "type": "string",
            "minLength": 1,
            "description": "The construction or wording question this investigation serves. Related details may belong to one question."
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Search strings actually run against the catalog or prompt vocabulary. Empty or absent for direct inspection without search."
          },
          "inspected_records": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Record identifiers opened in full, or vocabulary terms read, while resolving this question. A search result alone is not full record inspection."
          },
          "outcome": {
            "enum": [
              "adopted",
              "composed",
              "unused"
            ],
            "description": "adopted: selected knowledge or wording comes from inspected records. composed: the author resolves the question in wording, which may adapt inspected knowledge. unused: the investigation is not used in the final prompt."
          },
          "adopted_records": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Required when outcome is adopted: the selected record identifiers or vocabulary terms. Each must also occur in inspected_records."
          },
          "composed_wording": {
            "type": "string",
            "minLength": 1,
            "description": "Required when outcome is composed: the authored wording that resolves this question."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Required when outcome is composed or unused: why the authored wording resolves the question, or why the investigation is not used."
          }
        },
        "anyOf": [
          {
            "required": [
              "queries"
            ],
            "properties": {
              "queries": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "inspected_records"
            ],
            "properties": {
              "inspected_records": {
                "minItems": 1
              }
            }
          }
        ],
        "oneOf": [
          {
            "properties": {
              "outcome": {
                "const": "adopted"
              },
              "inspected_records": {
                "minItems": 1
              }
            },
            "required": [
              "adopted_records",
              "inspected_records"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "composed_wording"
                  ]
                },
                {
                  "required": [
                    "reason"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "outcome": {
                "const": "composed"
              }
            },
            "required": [
              "composed_wording",
              "reason"
            ],
            "not": {
              "required": [
                "adopted_records"
              ]
            }
          },
          {
            "properties": {
              "outcome": {
                "const": "unused"
              }
            },
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "adopted_records"
                  ]
                },
                {
                  "required": [
                    "composed_wording"
                  ]
                }
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "settled": {
      "type": "boolean"
    },
    "context": {
      "type": "object",
      "required": [
        "prompt_sha256",
        "plot_content_sha256"
      ],
      "properties": {
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plot_content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "vocabulary": {
      "$ref": "prompt-vocabulary-selection.schema.json"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "settled": {
            "const": true
          }
        },
        "required": [
          "settled"
        ]
      },
      "then": {
        "required": [
          "context"
        ]
      }
    }
  ]
}
