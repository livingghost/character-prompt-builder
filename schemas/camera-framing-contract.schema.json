{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "camera-framing-contract.schema.json",
  "title": "Camera Framing Contract",
  "description": "Each field holds the value the author decided, or the string \"unspecified\" where the author leaves it open.",
  "type": "object",
  "required": [
    "shot_type",
    "shot_scale",
    "distance_class",
    "subject_relative_distance",
    "camera_height",
    "pitch_degrees",
    "yaw_degrees",
    "roll_degrees",
    "lens_or_perspective",
    "lens_equivalent_mm",
    "projection_behavior",
    "frame_occupancy",
    "framing_and_crop",
    "coverage_landmarks",
    "nearest_form",
    "perspective_scale_change",
    "required_visible_elements",
    "allowed_offscreen_elements",
    "focal_sequence",
    "stability_invariants"
  ],
  "properties": {
    "shot_type": {
      "type": "string",
      "minLength": 1
    },
    "shot_scale": {
      "enum": [
        "extreme-close-up",
        "close-up",
        "head-and-shoulders",
        "chest-up",
        "waist-up",
        "upper-thigh",
        "three-quarter",
        "near-full-body",
        "full-body",
        "wide-environmental",
        "reference-sheet",
        "custom",
        "unspecified"
      ]
    },
    "distance_class": {
      "enum": [
        "contact-close",
        "very-close",
        "close",
        "medium-close",
        "medium",
        "medium-long",
        "long",
        "custom",
        "unspecified"
      ]
    },
    "subject_relative_distance": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "basis",
            "minimum",
            "maximum"
          ],
          "properties": {
            "basis": {
              "enum": [
                "head-heights",
                "visible-torso-heights",
                "full-body-heights",
                "subject-widths",
                "metres",
                "custom"
              ]
            },
            "minimum": {
              "type": "number",
              "minimum": 0
            },
            "maximum": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "human_scale_distance_equivalent_m": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "type": "number",
              "minimum": 0
            },
            "maximum": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "camera_height": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "reference_landmark",
            "offset"
          ],
          "properties": {
            "reference_landmark": {
              "type": "string",
              "minLength": 1
            },
            "offset": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "pitch_degrees": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "yaw_degrees": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "roll_degrees": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "lens_or_perspective": {
      "type": "string",
      "minLength": 1
    },
    "lens_equivalent_mm": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "minimum",
            "maximum"
          ],
          "properties": {
            "minimum": {
              "type": "number",
              "minimum": 1
            },
            "maximum": {
              "type": "number",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "projection_behavior": {
      "enum": [
        "orthographic-reference",
        "compressed-telephoto",
        "natural-portrait",
        "mild-wide",
        "wide",
        "fisheye",
        "custom",
        "unspecified"
      ]
    },
    "frame_occupancy": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "subject_height_percent",
            "subject_width_percent"
          ],
          "properties": {
            "subject_height_percent": {
              "type": "object",
              "required": [
                "minimum",
                "maximum"
              ],
              "properties": {
                "minimum": {
                  "type": "number",
                  "minimum": 0
                },
                "maximum": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "subject_width_percent": {
              "type": "object",
              "required": [
                "minimum",
                "maximum"
              ],
              "properties": {
                "minimum": {
                  "type": "number",
                  "minimum": 0
                },
                "maximum": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "framing_and_crop": {
      "type": "string",
      "minLength": 1
    },
    "coverage_landmarks": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "top",
            "bottom",
            "left",
            "right"
          ],
          "properties": {
            "top": {
              "type": "string",
              "minLength": 1
            },
            "bottom": {
              "type": "string",
              "minLength": 1
            },
            "left": {
              "type": "string",
              "minLength": 1
            },
            "right": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "eye_line_position": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "vertical_percent_from_top",
            "horizontal_percent_from_left"
          ],
          "properties": {
            "vertical_percent_from_top": {
              "type": "object",
              "required": [
                "minimum",
                "maximum"
              ],
              "properties": {
                "minimum": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "maximum": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "additionalProperties": false
            },
            "horizontal_percent_from_left": {
              "type": "object",
              "required": [
                "minimum",
                "maximum"
              ],
              "properties": {
                "minimum": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "maximum": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "nearest_form": {
      "type": "string",
      "minLength": 1
    },
    "perspective_scale_change": {
      "type": "string",
      "minLength": 1
    },
    "required_visible_elements": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "allowed_offscreen_elements": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "focal_sequence": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "stability_invariants": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 3,
          "uniqueItems": true
        },
        {
          "const": "unspecified"
        }
      ]
    },
    "reference_landmark_position": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional authored landmark position; does not imply eyes or a head."
    }
  },
  "additionalProperties": false
}
