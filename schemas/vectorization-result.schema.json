{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "artifact_type", "source_ref_id", "source_sha256", "source_media_type",
    "native_dimensions", "archival_svg_sha256", "candidate_pixel_sha256",
    "method", "selected_profile", "attempts", "quality_thresholds",
    "accepted_metrics", "quality_passed", "statistics", "constraints",
    "vectorization_result_sha256"
  ],
  "properties": {
    "artifact_type": {"const": "vectorization-result"},
    "source_ref_id": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_media_type": {"type": "string"},
    "native_dimensions": {
      "type": "object", "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "archival_svg_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_pixel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "method": {"const": "native-uniform-compact-perceptual-palette-connected-contours"},
    "selected_profile": {"type": "object"},
    "attempts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "quality_thresholds": {"type": "object"},
    "accepted_metrics": {"type": "object"},
    "quality_passed": {"type": "boolean"},
    "statistics": {"type": "object"},
    "constraints": {"type": "object"},
    "vectorization_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
