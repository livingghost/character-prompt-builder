{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["artifact_type", "audit_id", "source_ref_id", "source_sha256", "working_dimensions", "artifacts", "statistics", "notes", "audit_extraction_set_sha256"],
  "properties": {
    "artifact_type": {"const": "audit-extraction-set"},
    "audit_id": {"type": "string"},
    "source_ref_id": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "working_dimensions": {"type": "object"},
    "subject_mask_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "artifacts": {"type": "array", "minItems": 6, "items": {"type": "object"}},
    "statistics": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "audit_extraction_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
