  "operations": {
    "authorize": {
      "owner": "scripts/production_workflow.py:authorize",
      "command": "python scripts/production_workflow.py authorize --help",
      "effect": "reserve exact scoped operation in the run"
    },
    "claim-external": {
      "owner": "scripts/production_workflow.py:claim_external",
      "command": "python scripts/production_workflow.py claim-external --help",
      "effect": "reserve external submission before the host calls it"
    },
    "revision-intent": {
      "owner": "scripts/production_workflow.py:revision_intent",
      "command": "python scripts/production_workflow.py revision-intent --help",
      "effect": "read-only full preparation comparison for a reviewed repair"
    },
    "revise": {
      "owner": "scripts/production_workflow.py:revise",
      "command": "python scripts/production_workflow.py revise --help",
      "effect": "create a child run bound to the specific reviewed repair"
    },
    "adoption-intent": {
      "owner": "scripts/production_workflow.py:adoption_intent",
      "command": "python scripts/production_workflow.py adoption-intent --help",
      "effect": "bind exact canonical owner operation"
    },
    "adopt": {
      "owner": "scripts/production_workflow.py:adopt",
      "command": "python scripts/production_workflow.py adopt --help",
      "effect": "invoke the owner under separate authority"
    },
    "impact": {
      "owner": "scripts/production_workflow.py:impact",
      "command": "python scripts/production_workflow.py impact --help",
      "effect": "read-only changed-source and declared dependency report"
    },
    "resume": {
      "owner": "scripts/production_execution.py:resume",
      "command": "python scripts/production_workflow.py resume --help",
      "effect": "recover the same execution from retained evidence or one provider lookup without resending; --outcome-file records an evidenced not_executed statement"
    },
    "image-edit-intent": {
      "owner": "scripts/image_edit.py:edit_intent",
      "command": "python scripts/image_edit.py intent --help",
      "effect": "read-only exact pixel operation and reviewed repair binding"
    },
    "image-edit": {
      "owner": "scripts/image_edit.py:execute",
      "command": "python scripts/image_edit.py execute --help",
      "effect": "produce or recover one retained PNG candidate without inheriting review"
    },
    "export-review": {
      "owner": "scripts/artifact_review.py:export",
      "command": "python scripts/artifact_review.py --help",
      "effect": "export a read-only snapshot from existing production receipts"
    },
    "evaluate-evidence": {
      "owner": "scripts/evaluation_evidence.py:export",
      "command": "python scripts/evaluation_evidence.py --help",
      "effect": "aggregate declared attempts without model calls, selection or canonical writes"
    },
    "inspect-reference-delivery": {
      "owner": "scripts/reference_delivery.py:bindings",
      "command": "python scripts/reference_delivery.py --help",
      "effect": "inspect validated actual attachment and authority bindings"
    },
    "source-intake": {
      "owner": "scripts/source_material.py:ingest"
    },
    "source-proposal": {
      "owner": "scripts/source_material.py:propose"
    },
    "repair-analysis": {
      "owner": "scripts/repair_analysis.py:analyze",
      "command": "python scripts/repair_analysis.py --help",
      "effect": "derive failure groups and attributed hypotheses from existing review receipts; no retry or canonical writes"
    },
    "scene-persona-build": {
      "owner": "scripts/scene_persona.py:build",
      "command": "python scripts/scene_persona.py --help",
      "effect": "save exact definitions and authored scene applications after complete-source reading"
    },
    "scene-persona-verify": {
      "owner": "scripts/scene_persona.py:verify",
      "command": "python scripts/scene_persona.py --help",
      "effect": "verify complete originals and deterministic prepared material without rereading it through the model"
    },
    "source-material-ingest": {
      "owner": "scripts/source_material.py:ingest",
      "command": "python scripts/source_material.py ingest --help",
      "effect": "preserve original bytes and declared segments; no semantic inference or canonical adoption"
    },
    "source-material-propose": {
      "owner": "scripts/source_material.py:propose",
      "command": "python scripts/source_material.py propose --help",
      "effect": "bind authored extraction candidates to exact original source spans"
    },
    "agent-evaluation": {
      "owner": "scripts/agent_evaluation.py:run_study",
      "command": "python scripts/agent_evaluation.py --help",
      "effect": "execute only an explicitly approved host command plan; retain unknown and failed measurements"
    },
    "consult-presets": {
      "owner": "scripts/craft_consultation.py:command",
      "command": "python scripts/production_workflow.py consult-presets --help",
      "effect": "read craft records"
    },
    "apply-presets": {
      "owner": "scripts/craft_consultation.py:command",
      "command": "python scripts/production_workflow.py apply-presets --help",
      "effect": "publish scoped craft application as a production source"
    },
    "retarget": {
      "owner": "scripts/production_variation.py:retarget",
      "command": "python scripts/production_workflow.py retarget --help",
      "effect": "reassess a complete task for an explicitly different target"
    },
    "check": {
      "owner": "scripts/production_compiler.py:check_task",
      "command": "python scripts/production_workflow.py check --help",
      "effect": "report every preparation check, the request preview and the execution plan; no run, authorization or reservation"
    },
    "draft-execution": {
      "owner": "scripts/production_execution.py:draft_execution",
      "command": "python scripts/production_workflow.py draft-execution --help",
      "effect": "write the unanswered execution decisions for every planned operation; grants nothing"
    },
    "variant": {
      "owner": "scripts/production_variation.py:derive",
      "command": "python scripts/production_workflow.py variant --help",
      "effect": "prepare a new run from a prepared run with declared field changes; inherits no receipt, claim, review or selection"
    },
    "repeat": {
      "owner": "scripts/production_variation.py:derive",
      "command": "python scripts/production_workflow.py repeat --help",
      "effect": "prepare another run of the unchanged input under its own claim and authorization"
    },
    "status": {
      "owner": "scripts/production_execution.py:status",
