{
  "always_read": [
    "references/runtime/production-direction.md",
    "references/runtime/production-permissions.md",
    "references/runtime/production-execution.md"
  ],
  "external_inputs": [
    "task",
    "source-files",
    "delivery",
    "artifact-file",
    "review-file",
    "selection-file",
    "authorization-request",
    "authorization-receipt"
  ],
  "stages": [
    {
      "id": "prepare",
      "inputs": [
        "task",
        "source-files",
        "delivery"
      ],
      "outputs": [
        "prepared",
        "consumer"
      ],
      "next": "handoff",
      "on_failure": "prepare",
      "resume": "status",
      "owner": "scripts/production_workflow.py:prepare",
      "command": "python scripts/production_workflow.py prepare --help"
    },
    {
      "id": "handoff",
      "inputs": [
        "prepared",
        "consumer",
        "authorization-receipt"
      ],
      "outputs": [
        "handoff"
      ],
      "next": "capture",
      "on_failure": "prepare",
      "resume": "status",
      "owner": "scripts/production_workflow.py:handoff",
      "command": "python scripts/production_workflow.py handoff --help"
    },
    {
      "id": "capture",
      "inputs": [
        "handoff",
        "artifact-file"
      ],
      "outputs": [
        "candidate"
      ],
      "next": "review",
      "on_failure": "capture",
      "resume": "status",
      "owner": "scripts/production_workflow.py:capture",
      "command": "python scripts/production_workflow.py capture --help"
    },
    {
      "id": "review",
      "inputs": [
        "candidate",
        "review-file"
      ],
      "outputs": [
        "review"
      ],
      "next": "select",
      "on_failure": "review",
      "resume": "status",
      "owner": "scripts/production_workflow.py:review",
      "command": "python scripts/production_workflow.py review --help"
    },
    {
      "id": "select",
      "inputs": [
        "review",
        "selection-file",
        "authorization-receipt"
      ],
      "outputs": [
        "selection"
      ],
      "next": "complete",
      "on_failure": "review",
      "resume": "status",
      "owner": "scripts/production_workflow.py:select",
      "command": "python scripts/production_workflow.py select --help"
    },
    {
      "id": "complete",
      "inputs": [
        "selection"
      ],
      "outputs": [
        "completion"
      ],
      "next": "done",
      "on_failure": "prepare",
      "resume": "status",
      "owner": "scripts/production_workflow.py:complete",
      "command": "python scripts/production_workflow.py complete --help"
    }
  ],
